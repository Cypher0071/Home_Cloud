[Unit]
Description=Home Cloud Autonomous Server Agent & Dashboard
Documentation=https://github.com/Cypher0071/Home_Cloud
After=network.target network-online.target docker.service
Wants=network-online.target docker.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User={{USER}}
Group={{GROUP}}
SupplementaryGroups=docker

WorkingDirectory={{WORKING_DIR}}/agent
EnvironmentFile=-{{WORKING_DIR}}/agent/.env
Environment=NODE_ENV=production
Environment=SHELL=/bin/bash
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PATH={{NODE_DIR}}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStart="{{NODE_PATH}}" index.js

# Process Supervision & Auto-Restart
Restart=always
RestartSec=5s

# Graceful Shutdown Handling (Clean WebSocket, PTY, and Tunnel Termination)
KillSignal=SIGTERM
TimeoutStopSec=15s
KillMode=mixed

# System Safety Limits
LimitNOFILE=65535

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=home-cloud

[Install]
WantedBy=multi-user.target
