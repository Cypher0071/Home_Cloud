  "cards": [
    {
      "dot": "cyan",
      "title": "Dashboard capabilities",
      "items": [
        "Metrics arrive over Server-Sent Events; browser clients share one EventSource.",
        "Network detection checks LAN reachability and redirects a remote-host session to the local agent when reachable.",
        "File operations use BASE_DIR; host terminal and container exec use authenticated WebSockets.",
        "Docker UI manages containers, images, Compose projects, logs, stats, and exposed app routes."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and access",
      "items": [
        "Single-operator passcode; the JWT cookie gates privileged APIs. The service user belongs to the Docker group and host terminal exposes that user's shell.",
        "File explorer and container bind mounts are constrained to BASE_DIR; Compose definitions are executed by docker compose.",
        "Remote access is optional: when cloudflared config is absent, the agent remains available on the LAN."
      ]
    },
    {
      "dot": "amber",
      "title": "Repository and delivery scope",
      "items": [
        "pnpm workspace contains agent, dashboard, and landing packages; setup builds the dashboard and installs the agent as a systemd service.",
        "The Astro static landing package is separate from the Home Cloud runtime and is not shown in this system topology.",
        "Architecture is pinned to the committed repository revision; runtime values such as domain, ports, and BASE_DIR are environment-configurable."
      ]
    }
  ]
