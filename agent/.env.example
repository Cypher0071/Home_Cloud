PASSWORD=change-me
JWT_SECRET=generate-a-long-random-string

# File explorer jail. Defaults to the user home directory.
# BASE_DIR=/home/alice

# PORT=3000

# Cloudflare tunnel domain. Leave this unset to disable ingress autowiring.
# Home Cloud edits ~/.cloudflared/config.yml only after CF_DOMAIN is set,
# and only for hostnames on that domain. It does not default to home-cloud.live.
# CF_DOMAIN=example.com
# TUNNEL_NAME=home-cloud
# CF_CONFIG=/home/alice/.cloudflared/config.yml

# Set false if you log in over plain HTTP on LAN (cookie will not be Secure).
# COOKIE_SECURE=true
