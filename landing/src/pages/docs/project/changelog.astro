---
// /docs/project/changelog/: release notes pulled from GitHub at build time.
// The release workflow rebuilds the site on every published release, so this
// page never needs editing by hand.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { REPO, links } from '../../../data/site';

interface Release {
  tag_name: string;
  name: string | null;
  html_url: string;
  published_at: string | null;
  prerelease: boolean;
  draft: boolean;
  body_html?: string;
}

const headers: Record<string, string> = {
  // body_html is GitHub's own sanitized rendering of the release notes.
  Accept: 'application/vnd.github.html+json',
  'User-Agent': 'home-cloud-landing-build',
};
if (process.env.GITHUB_TOKEN) headers.Authorization = `Bearer ${process.env.GITHUB_TOKEN}`;

let releases: Release[] = [];
try {
  const res = await fetch(`https://api.github.com/repos/${REPO}/releases?per_page=50`, {
    headers,
    signal: AbortSignal.timeout(8000),
  });
  if (res.ok) releases = ((await res.json()) as Release[]).filter((r) => !r.draft);
} catch {
  releases = [];
}

const fmt = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '';
const slug = (tag: string) => tag.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const headings = releases.map((r) => ({ depth: 2, slug: slug(r.tag_name), text: r.tag_name }));
---

<StarlightPage
  frontmatter={{
    title: 'Changelog',
    description: 'Release notes for every Home Cloud version, pulled from GitHub Releases.',
    editUrl: false,
  }}
  headings={headings}
>
  <p>
    Every published release, newest first. Notes come straight from{' '}
    <a href={links.releases}>GitHub Releases</a>, and this page rebuilds when a new release is published.
    The full file history is in <a href={links.changelogFile}><code>CHANGELOG.md</code></a>.
  </p>

  {releases.length === 0 && (
    <p>Release notes could not be loaded at build time. See them on <a href={links.releases}>GitHub Releases</a>.</p>
  )}

  {releases.map((r) => (
    <section class="hc-release">
      <h2 id={slug(r.tag_name)}>{r.tag_name}</h2>
      <p class="hc-release-meta">
        {fmt(r.published_at)}
        {r.prerelease && <span class="hc-release-pre">Pre-release</span>}
        <a href={r.html_url}>View on GitHub</a>
      </p>
      {r.body_html ? <div class="hc-release-body" set:html={r.body_html} /> : <p>No release notes.</p>}
    </section>
  ))}
</StarlightPage>

<style>
  .hc-release-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    font-family: var(--hc-font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--hc-text-tertiary);
  }

  .hc-release-pre {
    padding: 1px 6px;
    border: 1px solid var(--hc-border-strong);
    border-radius: var(--hc-radius-sm);
  }

  .hc-release-body :global(:is(h1, h2)) {
    font-size: var(--sl-text-h3);
    border-top: none;
    padding-top: 0;
  }

  .hc-release + .hc-release {
    margin-top: 2.5rem;
  }
</style>
