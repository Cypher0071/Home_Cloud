---
// landing/src/components/HowItWorks.astro
// "How it works" — Griffin-style scroll story: sticky narrative rail on the
// left (eyebrow, heading, three numbered stages on a progress line), one
// continuous visual canvas on the right with a tall panel per stage.
// Active stage follows page scroll via IntersectionObserver; the rail fill
// tracks section scroll. No animation libraries, no elaborate scenes:
// typography and restrained geometry carry the visuals.
---

<section id="how-it-works" class="hiw">
  <div class="container hiw-container">
    <div class="hatch hiw-header-hatch" aria-hidden="true"></div>
    <div class="hiw-box">
      <div class="hiw-cols">
    <!-- Left: narrative + progress rail -->
    <div class="hiw-rail">
      <p class="hiw-eyebrow">HOW IT WORKS</p>
      <h2 class="hiw-title">Your machine. Your tunnel. Your cloud.</h2>
      <ol class="hiw-stages">
        <span class="rail-track" aria-hidden="true"><span class="rail-fill" id="hiw-rail-fill"></span></span>
        <li class="hiw-stage" data-active="true">
          <a class="stage-link" href="#hiw-stage-1" data-stage="0">
            <span class="stage-num" aria-hidden="true">01</span>
            <span class="stage-text">
              <span class="stage-heading">Run it at home</span>
              <span class="stage-desc">Install Home Cloud on a spare Linux PC. The agent serves your dashboard and tools locally on port 3000.</span>
            </span>
          </a>
        </li>
        <li class="hiw-stage" data-active="false">
          <a class="stage-link" href="#hiw-stage-2" data-stage="1">
            <span class="stage-num" aria-hidden="true">02</span>
            <span class="stage-text">
              <span class="stage-heading">Connect outward</span>
              <span class="stage-desc">Say yes during install and the installer sets up a Cloudflare Tunnel, HTTPS and DNS for you. It connects outward, so there are no router ports to open.</span>
            </span>
          </a>
        </li>
        <li class="hiw-stage" data-active="false">
          <a class="stage-link" href="#hiw-stage-3" data-stage="2">
            <span class="stage-num" aria-hidden="true">03</span>
            <span class="stage-text">
              <span class="stage-heading">Access it anywhere</span>
              <span class="stage-desc">Open your domain from any browser and sign in. At home it switches to your local network automatically.</span>
            </span>
          </a>
        </li>
      </ol>
    </div>

    <!-- Right: one continuous canvas, one panel per stage -->
    <div class="hiw-canvas">
      <div class="hiw-panel" id="hiw-stage-1">
        <p class="viz-caption" aria-hidden="true"><span>01</span>Run it at home</p>
        <p class="viz-kicker">HOME CLOUD AGENT</p>
        <p class="viz-giant">:3000</p>
        <div class="viz-meta">
          <p><strong>HOST</strong><span>SPARE LINUX PC</span></p>
          <p><strong>ORIGIN</strong><span>LOCALHOST</span></p>
        </div>
      </div>

      <div class="hiw-panel" id="hiw-stage-2">
        <p class="viz-caption" aria-hidden="true"><span>02</span>Connect outward</p>
        <p class="viz-giant viz-giant-outbound">OUTBOUND</p>
        <div class="tunnel-bar" aria-hidden="true"><span class="tunnel-core"></span></div>
        <div class="tunnel-ends">
          <span>HOME PC</span>
          <span class="tunnel-note">0 INBOUND ROUTER PORTS</span>
          <span>CLOUDFLARE EDGE</span>
        </div>
      </div>

      <div class="hiw-panel hiw-panel-film" id="hiw-stage-3">
        <p class="viz-caption" aria-hidden="true"><span>03</span>Access it anywhere</p>
        <div class="hiw-desktop-slot" id="hiw-stage3-slot" role="region" aria-label="Home Cloud desktop dashboard preview">
          <noscript>
            <div class="hiw-slot-noscript">
              <span class="viz-kicker">HOME CLOUD DESKTOP</span>
              <p class="viz-giant" style="font-size: clamp(32px, 5vw, 48px); margin-top: 8px;">:3000</p>
            </div>
          </noscript>
        </div>
        <p class="hiw-slot-caption" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5"></rect><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"></path></svg>
          <span>https://dash.&lt;your-domain&gt;</span>
        </p>
        <!-- Scroll runway while the preview plays its tour (height set by ProductDemo). -->
        <div class="hiw-hold" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</div>

</div>
</section>

<style>
  .hiw {
    position: relative;
    padding-block: 0;
    background: transparent;
  }

  .hiw-box {
    border-left: 1px solid var(--hc-border-subtle);
    border-right: 1px solid var(--hc-border-subtle);
    padding: 0;
    box-sizing: border-box;
  }

  .hiw-header-hatch {
    height: var(--hc-hatch-height, 28px);
    background-color: var(--hc-canvas);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      var(--hc-border-default) 6px 7px
    );
    border: 1px solid var(--hc-border-subtle);
    box-sizing: border-box;
  }

  .hiw-header-hatch {
    position: sticky;
    top: 56px;
    z-index: 20;
  }

  .hiw-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0;
    align-items: start;
  }

  /* ---- Left rail ---- */
  .hiw-rail {
    position: sticky;
    top: 84px;
    /* Faded out by ProductDemo while the desktop grows out of step 3. */
    padding-block: clamp(64px, 8vh, 96px);
    padding-inline: clamp(24px, 4vw, 48px);
    box-sizing: border-box;
  }

  .hiw-eyebrow {
    margin-bottom: var(--hc-space-4);
    font-family: var(--hc-font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--hc-text-tertiary);
  }

  .hiw-title {
    margin-bottom: var(--hc-space-6);
    font-family: var(--hc-font-display);
    font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--hc-text-primary);
  }

  .hiw-stages {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--hc-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--hc-space-6);
  }

  .rail-track {
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--hc-border-subtle);
  }

  .rail-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.28);
    transform: scaleY(0.33);
    transform-origin: top;
  }

  .stage-link {
    display: flex;
    gap: var(--hc-space-4);
    text-decoration: none;
  }

  .stage-num {
    font-family: var(--hc-font-mono);
    font-size: 12px;
    color: var(--hc-text-muted);
    padding-top: 3px;
    transition: color 300ms var(--hc-ease-out);
  }

  .stage-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stage-heading {
    font-size: 1.02rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: var(--hc-text-secondary);
    transition: color 300ms var(--hc-ease-out);
  }

  .stage-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--hc-text-tertiary);
    transition: color 300ms var(--hc-ease-out);
  }

  .stage-desc code {
    font-family: var(--hc-font-mono);
    font-size: 0.85em;
    color: inherit;
  }

  .hiw-stage[data-active='true'] .stage-num {
    color: var(--hc-accent);
  }

  .hiw-stage[data-active='true'] .stage-heading {
    color: var(--hc-text-primary);
  }

  .hiw-stage[data-active='true'] .stage-desc {
    color: var(--hc-text-secondary);
  }

  /* ---- Right canvas: one continuous surface ---- */
  .hiw-canvas {
    border: none;
    border-left: 1px solid var(--hc-border-subtle);
    border-radius: 0;
    background: var(--hc-canvas);
    overflow: hidden;
  }

  /* Space above panel 1 so it is centred when the rail pins (set by the script). */
  @media (min-width: 901px) {
    .hiw-canvas {
      padding-top: var(--hiw-lead, 0px);
    }
  }

  .hiw-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--hc-space-5);
    min-height: min(72vh, 640px);
    padding: clamp(32px, 4vw, 64px);
    scroll-margin-top: 120px;
    transition: opacity 300ms var(--hc-ease-out);
  }

  /* Dim inactive panels only when JS drives the active state (html.js). */
  html.js .hiw-panel {
    opacity: 0.45;
  }

  html.js .hiw-panel[data-active='true'] {
    opacity: 1;
  }

  .hiw-panel + .hiw-panel {
    border-top: 1px solid var(--hc-border-subtle);
  }

  /* Step 3 hosts the product film: top-aligned, with a runway below it. */
  .hiw-panel-film {
    justify-content: flex-start;
    padding-top: clamp(48px, 9vh, 112px);
  }

  .hiw-hold {
    flex: none;
    height: var(--hiw-hold, 0px);
  }

  .viz-caption {
    display: none;
  }

  .hiw-desktop-slot {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
    position: relative;
    border-radius: 12px;
    border: 1px solid var(--hc-border-subtle);
    background: rgba(255, 255, 255, 0.02);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    box-sizing: border-box;
    aspect-ratio: var(--desktop-aspect-ratio, 1147 / 625);
    pointer-events: none;
    transition:
      border-color 300ms var(--hc-ease-out),
      background-color 300ms var(--hc-ease-out),
      box-shadow 300ms var(--hc-ease-out);
  }

  .hiw-desktop-slot[data-transitioning='true'] {
    border-color: transparent;
    background-color: transparent;
    box-shadow: none;
  }

  /* Caption under the preview: where you would open it. Leaves with the preview. */
  .hiw-slot-caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0;
    font-family: var(--hc-font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--hc-text-tertiary);
    transition: opacity 200ms var(--hc-ease-out);
  }

  .hiw-desktop-slot[data-transitioning='true'] ~ .hiw-slot-caption {
    opacity: 0;
  }

  .hiw-slot-noscript {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 220px;
    text-align: center;
  }

  .viz-kicker {
    font-family: var(--hc-font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--hc-text-tertiary);
  }

  .viz-giant {
    margin: 0;
    font-family: var(--hc-font-display);
    font-size: clamp(96px, 11vw, 176px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--hc-text-primary);
  }

  .viz-giant-outbound {
    font-size: clamp(56px, 7vw, 108px);
  }

  .viz-meta {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--hc-border-subtle);
  }

  .viz-meta p {
    display: flex;
    gap: var(--hc-space-4);
    margin: 0;
    padding: 10px 0;
    border-bottom: 1px solid var(--hc-border-subtle);
    font-family: var(--hc-font-mono);
    font-size: 12px;
  }

  .viz-meta strong {
    min-width: 72px;
    font-weight: 500;
    color: var(--hc-text-tertiary);
  }

  .viz-meta span {
    color: var(--hc-text-secondary);
  }

  /* Stage 02: the defining event */
  .tunnel-bar {
    position: relative;
    height: 22px;
    background: var(--hc-surface-3);
    border: 1px solid var(--hc-border-default);
    border-radius: 999px;
  }

  .tunnel-core {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    transform: translateY(-50%);
    border-radius: 999px;
    background: var(--hc-accent);
  }

  .tunnel-ends {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--hc-font-mono);
    font-size: 11px;
    color: var(--hc-text-tertiary);
  }

  .tunnel-note {
    letter-spacing: 0.06em;
    color: var(--hc-text-secondary);
  }

  /* ---- Mobile: vertical text+visual sequence ---- */
  @media (max-width: 900px) {
    .hiw-cols {
      grid-template-columns: 1fr;
    }
    .hiw-header-hatch {
      position: static;
    }
    .hiw-rail {
      position: static;
      padding-block: clamp(40px, 6vh, 64px);
      padding-inline: clamp(20px, 4vw, 36px);
    }
    .hiw-canvas {
      border-left: none;
      border-top: 1px solid var(--hc-border-subtle);
      overflow: visible;
    }
    .hiw-panel {
      min-height: 0;
      padding: 32px clamp(20px, 4vw, 36px);
    }
    .viz-giant {
      font-size: clamp(72px, 22vw, 120px);
    }
    .viz-giant-outbound {
      font-size: clamp(44px, 13vw, 72px);
    }
    .viz-caption {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin: 0;
      font-size: 0.95rem;
      font-weight: 550;
      color: var(--hc-text-primary);
    }
    .viz-caption span {
      font-family: var(--hc-font-mono);
      font-size: 12px;
      color: var(--hc-accent);
    }
  }

  /* .hiw-hatch height controlled via --hc-hatch-height */

  @media (prefers-reduced-motion: reduce) {
    .hiw-panel,
    .stage-num,
    .stage-heading,
    .stage-desc {
      transition: none;
    }
  }
</style>

<script>
  // Scroll story. On desktop the left rail is pinned while the right panels
  // scroll past, and everything is keyed to one rule: step N is "reached" when
  // its panel (for step 3, the desktop preview) is centred in the viewport.
  // At that scroll position the progress line sits exactly on step N and step N
  // is the active one. Between two steps the line moves linearly. No libraries,
  // no scroll hijacking.
  const section = document.getElementById('how-it-works');
  const fill = document.getElementById('hiw-rail-fill');
  const canvas = section?.querySelector('.hiw-canvas');
  const rail = section?.querySelector('.hiw-rail');
  const stages = section ? Array.from(section.querySelectorAll('.hiw-stage')) : [];
  const panels = section ? Array.from(section.querySelectorAll('.hiw-panel')) : [];
  const slot = document.getElementById('hiw-stage3-slot');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = window.matchMedia('(min-width: 901px)');

  let activeIndex = 0;
  let ticking = false;
  let anchors = null; // scroll positions where each step is reached (desktop)
  let marks = null;   // progress-line fraction at each step (desktop)
  let tail = 0;       // scroll distance after step 3 over which the line finishes
  let lastFill = -1;

  function setActive(index) {
    if (index === activeIndex) return;
    activeIndex = index;
    stages.forEach((stage, i) => {
      stage.setAttribute('data-active', String(i === index));
    });
    panels.forEach((panel, i) => {
      if (i === index) {
        panel.setAttribute('data-active', 'true');
      } else {
        panel.removeAttribute('data-active');
      }
    });
    window.dispatchEvent(new CustomEvent('hiw-stage-change', { detail: { activeIndex: index } }));
  }

  function setFill(value) {
    if (!fill || Math.abs(value - lastFill) < 0.0005) return;
    lastFill = value;
    fill.style.transform = `scaleY(${value.toFixed(4)})`;
  }

  function viewportMid() {
    const navH = document.getElementById('nav')?.getBoundingClientRect().height || 0;
    return (window.innerHeight + navH) / 2;
  }

  // Layout pass: runs on load, resize and font load, never per scroll frame.
  function measure() {
    if (!section || !canvas || !rail || panels.length < 3) return;
    if (!wide.matches) {
      anchors = null;
      marks = null;
      canvas.style.removeProperty('--hiw-lead');
      return;
    }

    const mid = viewportMid();
    const pinTop = parseFloat(getComputedStyle(rail).top) || 0;

    // Lead-in above panel 1 so it is centred the moment the rail pins.
    const lead = Math.max(0, Math.round(mid - pinTop - panels[0].offsetHeight / 2));
    if (canvas.style.getPropertyValue('--hiw-lead') !== `${lead}px`) {
      canvas.style.setProperty('--hiw-lead', `${lead}px`);
    }

    const sy = window.scrollY;
    const centreOf = (el) => {
      const r = el.getBoundingClientRect();
      return r.top + sy + r.height / 2;
    };
    anchors = [
      centreOf(panels[0]) - mid,
      centreOf(panels[1]) - mid,
      centreOf(slot || panels[2]) - mid,
    ];

    // Where the line must be for each step: the middle of its number.
    const track = fill?.parentElement;
    if (track) {
      const tr = track.getBoundingClientRect();
      marks = stages.map((stage) => {
        const num = stage.querySelector('.stage-num');
        const r = num.getBoundingClientRect();
        return Math.min(1, Math.max(0.02, (r.top + r.height / 2 - tr.top) / tr.height));
      });
    }
    tail = Number(section.dataset.hold) || 0;
  }

  function update() {
    if (!section) return;
    const y = window.scrollY;

    if (anchors && marks) {
      // Active step: the one whose anchor is nearest.
      const next = y >= (anchors[1] + anchors[2]) / 2 ? 2 : y >= (anchors[0] + anchors[1]) / 2 ? 1 : 0;
      setActive(next);

      let f;
      if (y <= anchors[0]) f = marks[0];
      else if (y <= anchors[1]) f = marks[0] + (marks[1] - marks[0]) * ((y - anchors[0]) / (anchors[1] - anchors[0]));
      else if (y <= anchors[2]) f = marks[1] + (marks[2] - marks[1]) * ((y - anchors[1]) / (anchors[2] - anchors[1]));
      else f = marks[2] + (1 - marks[2]) * Math.min(1, (y - anchors[2]) / Math.max(1, tail));
      setFill(f);
      return;
    }

    // Stacked (mobile) layout: the line tracks section scroll.
    const rect = section.getBoundingClientRect();
    const span = rect.height - window.innerHeight;
    const p = span > 0 ? (0 - rect.top) / span : 1;
    setFill(0.05 + Math.min(1, Math.max(0, p)) * 0.95);
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      update();
    });
  }

  function remeasure() {
    measure();
    update();
  }

  if (section && panels.length > 0) {
    panels[0].setAttribute('data-active', 'true');

    // Stacked layout only: the active step follows whichever panel is mid-screen.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (wide.matches) return;
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const index = panels.indexOf(entry.target);
              if (index >= 0) setActive(index);
            }
          }
        },
        { rootMargin: '-42% 0px -42% 0px', threshold: 0 },
      );
      panels.forEach((panel) => io.observe(panel));
    }

    measure();
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', remeasure, { passive: true });
    window.addEventListener('load', remeasure);
    wide.addEventListener?.('change', remeasure);
    document.fonts?.ready.then(remeasure);
    // The step 3 runway (hold) is set by the demo script after this one runs.
    if ('ResizeObserver' in window) new ResizeObserver(remeasure).observe(section);

    // Rail links go to each step's anchor (desktop) or its panel (stacked).
    section.querySelectorAll('.stage-link').forEach((link, i) => {
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        const target = section.querySelector(href);
        if (!target) return;
        event.preventDefault();
        const behavior = reduceMotion ? 'auto' : 'smooth';
        if (anchors) window.scrollTo({ top: anchors[i], behavior });
        else target.scrollIntoView({ behavior, block: 'center' });
      });
    });
  }
</script>
