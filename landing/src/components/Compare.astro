---
// landing/src/components/Compare.astro
// Honest comparison against the tools people usually weigh Home Cloud
// against. Facts come from each project's own docs/repo (checked Nov 2026).
// Keep every cell verifiable; when in doubt, leave the row out.
import { links } from '../data/site';

type Mark = 'yes' | 'no' | 'part';
type Cell = [Mark, string];

const products = ['Home Cloud', 'CasaOS', 'umbrelOS', 'Portainer CE', 'Cockpit'];

const rows: { label: string; cells: Cell[] }[] = [
  {
    label: 'Installs on the Linux you already run',
    cells: [['yes', 'Yes'], ['yes', 'Yes'], ['no', 'No, own OS'], ['yes', 'As a container'], ['yes', 'Yes']],
  },
  {
    label: 'Remote access with no port forwarding, built in',
    cells: [['yes', 'Set up by the installer'], ['no', 'Not built in'], ['part', 'Tailscale app'], ['no', 'Not built in'], ['no', 'Not built in']],
  },
  {
    label: 'Host terminal in the browser',
    cells: [['yes', 'Yes'], ['part', 'Over SSH'], ['yes', 'Yes'], ['part', 'Containers only'], ['yes', 'Yes']],
  },
  {
    label: 'Host file manager',
    cells: [['yes', 'Yes'], ['yes', 'Yes'], ['yes', 'Yes'], ['no', 'No'], ['part', 'Plugin']],
  },
  {
    label: 'Docker and Compose management',
    cells: [['yes', 'Yes'], ['yes', 'Compose import'], ['part', 'Portainer app'], ['yes', 'Swarm and Kubernetes too'], ['part', 'Podman; Docker plugin']],
  },
  {
    label: 'One-click app store',
    cells: [['no', 'No'], ['yes', 'Yes'], ['yes', '300+ apps'], ['part', 'Templates'], ['no', 'No']],
  },
  {
    label: 'ARM / Raspberry Pi',
    cells: [['no', 'Untested'], ['yes', 'Yes'], ['yes', 'Pi 4 and 5'], ['yes', 'Yes'], ['yes', 'Yes']],
  },
  {
    label: 'License',
    cells: [['yes', 'Apache-2.0'], ['yes', 'Apache-2.0'], ['part', 'PolyForm Noncommercial'], ['yes', 'zlib'], ['yes', 'LGPL-2.1+']],
  },
];

const different = [
  {
    title: 'Remote access is part of install',
    body: 'Answer one prompt and the installer creates the Cloudflare Tunnel, HTTPS and DNS. No VPS, VPN client or router changes, and it works behind CGNAT. At home it switches to your local network automatically.',
  },
  {
    title: 'Host and containers in one place',
    body: 'A real host shell, host files, Docker and Compose, and live system stats in a single dashboard, on the distro you already run.',
  },
  {
    title: 'Plainly open source',
    body: 'Apache-2.0, with no paid tier. Read every line, fork it, ship it.',
  },
];

const ahead = [
  'App stores: CasaOS, umbrelOS and others install apps in one click. Home Cloud has no app store, but its Docker management can pull and run any open source app from an image or Compose file.',
  'Multiple users: umbrelOS, Cockpit and Portainer Business support more than one account. Home Cloud is single-owner.',
  'ARM: CasaOS, umbrelOS, Portainer and Cockpit run on ARM. Home Cloud is tested on x86_64 only.',
];

const markLabel: Record<Mark, string> = { yes: 'Supported', no: 'Not supported', part: 'Partly or via add-on' };
---

<section id="compare" class="band compare" aria-labelledby="compare-title">
  <div class="container">
    <div class="band-frame">
      <header class="band-header reveal">
        <div>
          <p class="band-eyebrow">COMPARE</p>
          <h2 id="compare-title" class="band-title">How it stacks up.</h2>
        </div>
        <p class="band-lede">
          Home Cloud is not an app store or a NAS OS. It is a control panel for one Linux machine, with remote access that sets itself up. Here is where that helps and where others do more.
        </p>
      </header>

      <label class="compare-vs" for="compare-vs-select">
        <span>Compare Home Cloud with</span>
        <select id="compare-vs-select">
          {products.slice(1).map((p, i) => <option value={String(i + 1)}>{p}</option>)}
        </select>
      </label>

      <div class="compare-key">
        <ul class="compare-legend" aria-hidden="true">
          <li><span class="compare-mark is-yes"><svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" /></svg></span>Yes</li>
          <li><span class="compare-mark is-part"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="4.5" /><path d="M8 3.5a4.5 4.5 0 0 0 0 9z" class="fill" /></svg></span>Partly or add-on</li>
          <li><span class="compare-mark is-no"><svg viewBox="0 0 16 16"><path d="M4.5 8h7" /></svg></span>No</li>
        </ul>
      </div>

      <div class="compare-scroll reveal" data-reveal-delay="1" tabindex="0" role="region" aria-label="Comparison table, scrolls horizontally">
        <table class="compare-table" data-vs="1">
          <thead>
            <tr>
              <th scope="col" class="compare-corner" data-col="0">
                <span class="compare-corner-label">Capability</span>
              </th>
              {products.map((p, i) => (
                <th scope="col" class:list={['compare-product', { 'is-us': i === 0 }]} data-col={i + 1} data-c={i > 0 ? i : undefined}>
                  {i === 0 && (
                    <svg class="compare-logo" viewBox="0 0 32 32" width="18" height="18" fill="none" aria-hidden="true">
                      <circle cx="22.5" cy="9.5" r="3" fill="var(--hc-accent)" />
                      <path d="M9 21.5h14a4.5 4.5 0 0 0 .6-8.96A6.5 6.5 0 0 0 11.1 14 3.75 3.75 0 0 0 9 21.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                    </svg>
                  )}
                  {p}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row" class="compare-label" data-col="0">{row.label}</th>
                {row.cells.map(([mark, text], i) => (
                  <td class:list={['compare-cell', `is-${mark}`, { 'is-us': i === 0 }]} data-col={i + 1} data-c={i > 0 ? i : undefined}>
                    <span class="compare-mark" aria-hidden="true">
                      {mark === 'yes' && <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" /></svg>}
                      {mark === 'part' && <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="4.5" /><path d="M8 3.5a4.5 4.5 0 0 0 0 9z" class="fill" /></svg>}
                      {mark === 'no' && <svg viewBox="0 0 16 16"><path d="M4.5 8h7" /></svg>}
                    </span>
                    <span class="sr-only">{markLabel[mark]}: </span>
                    {text !== 'Yes' && text !== 'No' && text}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="compare-notes">
        <div class="compare-col">
          <h3 class="compare-col-title">Where Home Cloud is different</h3>
          <ul class="compare-diff">
            {different.map((d) => (
              <li>
                <span class="compare-diff-title">{d.title}</span>
                <p>{d.body}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="compare-col">
          <h3 class="compare-col-title">Where others are ahead</h3>
          <ul class="compare-diff">
            {ahead.map((a) => {
              const [head, ...rest] = a.split(': ');
              return (
                <li>
                  <span class="compare-diff-title">{head}</span>
                  <p>{rest.join(': ')}</p>
                </li>
              );
            })}
          </ul>
        </div>
      </div>

      <div class="band-foot">
        <p>Checked against each project's own docs in November 2026. Spotted something out of date?</p>
        <a href={links.issues} target="_blank" rel="noopener noreferrer">Open an issue <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
    <div class="band-hatch" aria-hidden="true"></div>
  </div>
</section>

<script>
  // Row/column hover highlight, and the phone-width "compare with" picker.
  const table = document.querySelector<HTMLTableElement>('.compare-table');
  if (table) {
    let hot = '';
    const setHot = (col: string) => {
      if (col === hot) return;
      table.querySelectorAll('.is-hot').forEach((el) => el.classList.remove('is-hot'));
      hot = col;
      if (col && col !== '0') table.querySelectorAll(`[data-col="${col}"]`).forEach((el) => el.classList.add('is-hot'));
    };
    table.addEventListener('pointerover', (e) => {
      if ((e as PointerEvent).pointerType === 'touch') return;
      setHot((e.target as HTMLElement).closest<HTMLElement>('[data-col]')?.dataset.col ?? '');
    });
    table.addEventListener('pointerleave', () => setHot(''));

    const select = document.querySelector<HTMLSelectElement>('#compare-vs-select');
    select?.addEventListener('change', () => {
      table.dataset.vs = select.value;
    });
  }
</script>

<style>
  .compare-scroll {
    overflow-x: auto;
    border-top: 1px solid var(--hc-border-default);
    scrollbar-width: thin;
    scrollbar-color: var(--hc-border-strong) transparent;
  }

  .compare-scroll:focus-visible {
    outline: 2px solid var(--hc-accent);
    outline-offset: -2px;
  }

  .compare-table {
    width: 100%;
    min-width: 880px;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .compare-table th,
  .compare-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--hc-border-default);
    border-right: 1px solid var(--hc-border-default);
    text-align: left;
    vertical-align: top;
  }

  .compare-table tr > :last-child {
    border-right: none;
  }

  .compare-table tbody tr:last-child > * {
    border-bottom: none;
  }

  .compare-corner,
  .compare-label {
    width: 24%;
    padding-left: clamp(24px, 4vw, 48px) !important;
  }

  .compare-product {
    font-family: var(--hc-font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .compare-product.is-us {
    color: var(--hc-text-primary);
  }

  .compare-label {
    font-family: var(--hc-font-sans);
    font-size: var(--hc-text-small);
    font-weight: 500;
    line-height: 1.45;
    color: var(--hc-text-primary);
  }

  .compare-cell {
    position: relative;
    padding-left: 44px !important;
    font-size: var(--hc-text-small);
    line-height: 1.45;
    color: var(--hc-text-secondary);
  }

  /* Our column: orange rule on top, warm tint all the way down. */
  .compare-table .is-us {
    background: color-mix(in srgb, var(--hc-accent) 3.5%, var(--hc-surface-1));
  }

  .compare-product.is-us {
    box-shadow: inset 0 2px 0 var(--hc-accent);
  }

  .compare-logo {
    display: inline-block;
    vertical-align: -3px;
    margin-right: 8px;
  }

  /* Hover: a soft wash over the row and the column under the pointer. */
  .compare-table tbody tr:hover > *,
  .compare-table .is-hot {
    background-image: linear-gradient(rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.035));
  }

  /* Key: one slim row above the table instead of a tall stack in the corner. */
  .compare-key {
    display: flex;
    justify-content: flex-end;
    padding: 10px clamp(24px, 4vw, 48px);
    border-top: 1px solid var(--hc-border-strong);
  }

  .compare-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--hc-font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--hc-text-tertiary);
  }

  .compare-legend li {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .compare-legend .compare-mark {
    position: static;
  }

  .compare-corner-label {
    font-family: var(--hc-font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-muted);
  }

  /* Picker is phone-only and needs JS. */
  .compare-vs {
    display: none;
  }

  .compare-cell.is-us {
    color: var(--hc-text-primary);
  }

  .compare-cell.is-no {
    color: var(--hc-text-tertiary);
  }

  .compare-cell .compare-mark {
    position: absolute;
    left: 20px;
    top: 16px;
  }

  .compare-mark {
    display: inline-flex;
  }

  .compare-mark svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .is-yes .compare-mark svg,
  .compare-mark.is-yes svg {
    stroke: var(--hc-success);
  }

  .is-part .compare-mark svg,
  .compare-mark.is-part svg {
    stroke: var(--hc-warn);
  }

  .is-part .compare-mark .fill,
  .compare-mark.is-part .fill {
    fill: var(--hc-warn);
  }

  .is-no .compare-mark svg,
  .compare-mark.is-no svg {
    stroke: var(--hc-text-muted);
  }

  .compare-notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--hc-border-strong);
  }

  .compare-col {
    min-width: 0;
    padding: var(--hc-space-6) clamp(24px, 4vw, 48px) var(--hc-space-7);
  }

  .compare-col + .compare-col {
    border-left: 1px solid var(--hc-border-strong);
  }

  .compare-col-title {
    margin-bottom: var(--hc-space-5);
    font-family: var(--hc-font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .compare-col {
    display: flex;
    flex-direction: column;
  }

  /* Three equal rows per side so the two columns line up row for row. */
  .compare-diff {
    flex: 1;
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .compare-diff li {
    padding-block: var(--hc-space-4);
    border-bottom: 1px solid var(--hc-border-default);
  }

  .compare-diff li:first-child {
    padding-top: 0;
  }

  .compare-diff li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .compare-diff-title {
    display: block;
    margin-bottom: 4px;
    font-family: var(--hc-font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--hc-text-primary);
  }

  .compare-diff p {
    max-width: 52ch;
    font-size: var(--hc-text-small);
    line-height: 1.6;
    color: var(--hc-text-secondary);
  }

  @media (max-width: 960px) {
    .compare-notes {
      grid-template-columns: minmax(0, 1fr);
    }

    .compare-col + .compare-col {
      border-left: none;
      border-top: 1px solid var(--hc-border-strong);
    }
  }

  /* Phones: Home Cloud against one other product, picked from a dropdown.
     Without JS the full table stays and scrolls sideways. */
  @media (max-width: 760px) {
    :global(html.js) .compare-vs {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--hc-space-3);
      padding: var(--hc-space-3) var(--hc-space-4);
      border-top: 1px solid var(--hc-border-strong);
      font-family: var(--hc-font-mono);
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--hc-text-tertiary);
    }

    .compare-vs select {
      padding: 7px 28px 7px 10px;
      border: 1px solid var(--hc-border-strong);
      border-radius: var(--hc-radius-sm);
      background: var(--hc-surface-1);
      font: inherit;
      color: var(--hc-text-primary);
    }

    .compare-vs select:focus-visible {
      outline: 2px solid var(--hc-accent);
      outline-offset: 2px;
    }

    :global(html.js) .compare-table {
      min-width: 0;
    }

    :global(html.js) .compare-table[data-vs="1"] [data-c]:not([data-c="1"]),
    :global(html.js) .compare-table[data-vs="2"] [data-c]:not([data-c="2"]),
    :global(html.js) .compare-table[data-vs="3"] [data-c]:not([data-c="3"]),
    :global(html.js) .compare-table[data-vs="4"] [data-c]:not([data-c="4"]) {
      display: none;
    }

    :global(html.js) .compare-corner,
    :global(html.js) .compare-label {
      width: 36%;
    }

    .compare-table th,
    .compare-table td {
      padding: 12px 10px;
    }

    .compare-corner,
    .compare-label {
      padding-left: var(--hc-space-4) !important;
    }

    .compare-cell {
      padding-left: 32px !important;
    }

    .compare-cell .compare-mark {
      left: 10px;
      top: 14px;
    }

    .compare-key {
      justify-content: flex-start;
      padding-inline: var(--hc-space-4);
    }
  }

  @media (max-width: 640px) {
    .compare-col {
      padding-inline: var(--hc-space-4);
    }
  }
</style>
