---
// landing/src/components/Features.astro
// Feature grid: four implemented capabilities, each with a compact preview
// that resembles the real product. Preview data is illustrative where noted;
// no fabricated measurements, no unimplemented features.
---

<section id="features" class="features-section">
  <div class="container">
    <div class="features-box">
      <div class="features-header reveal">
      <h2 class="features-title">
        Everything runs on your machine.
      </h2>
      <p class="features-desc">
        Four tools served by the agent on your spare PC — no cloud VM,
        no separate services.
      </p>
    </div>

    <div class="features-bento-grid">
      <!-- 01: Terminal -->
      <div class="bento-card reveal">
        <div class="card-icon-bar">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <span class="card-num">01</span>
        </div>

        <h3 class="card-title">Terminal in Your Browser</h3>
        <p class="card-desc">
          Run commands on your home machine from a browser-based terminal.
          Interactive PTY sessions with persistence and replay — the shell runs
          as the agent user, not in a sandbox.
        </p>

        <div class="card-micro-preview terminal-preview">
          <div class="preview-chrome">
            <span class="p-title">terminal · PTY</span>
          </div>
          <div class="preview-body mono">
            <div class="code-line"><span class="c-prompt">$</span> <span class="c-cmd">ls ~/media</span></div>
            <div class="code-line c-dim">movies&ensp;&ensp;music&ensp;&ensp;backups</div>
            <div class="code-line"><span class="c-prompt">$</span> <span class="c-caret">▊</span></div>
          </div>
        </div>
      </div>

      <!-- 02: Docker -->
      <div class="bento-card reveal">
        <div class="card-icon-bar">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.3 7 12 12 20.7 7"></polyline>
              <line x1="12" y1="22" x2="12" y2="12"></line>
            </svg>
          </div>
          <span class="card-num">02</span>
        </div>

        <h3 class="card-title">Docker Management</h3>
        <p class="card-desc">
          Manage containers and images, read logs, inspect resource usage, pull
          image updates, and deploy Compose projects — all from the dashboard.
        </p>

        <div class="card-micro-preview docker-preview">
          <div class="preview-chrome">
            <span class="p-title">containers</span>
            <span class="p-note">SAMPLE ENTRIES</span>
          </div>
          <div class="docker-mini-row">
            <span class="mini-status-led"></span>
            <span class="mini-name">media-server</span>
            <span class="mini-state">running</span>
          </div>
          <div class="docker-mini-row">
            <span class="mini-status-led"></span>
            <span class="mini-name">home-wiki</span>
            <span class="mini-state">running</span>
          </div>
          <div class="docker-mini-row is-stopped">
            <span class="mini-status-led"></span>
            <span class="mini-name">test-build</span>
            <span class="mini-state">stopped</span>
          </div>
        </div>
      </div>

      <!-- 03: Files -->
      <div class="bento-card reveal">
        <div class="card-icon-bar">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <span class="card-num">03</span>
        </div>

        <h3 class="card-title">Direct File Management</h3>
        <p class="card-desc">
          Browse, upload, download, search, and manage files on the host through
          the browser. File APIs stay inside the configured <code>BASE_DIR</code>.
        </p>

        <div class="card-micro-preview file-preview">
          <div class="preview-chrome">
            <span class="p-title">~/media</span>
          </div>
          <div class="file-item">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M1 3.5A1.5 1.5 0 0 1 2.5 2h2.764c.958 0 1.76.56 2.311 1.184l.73.816H13.5A1.5 1.5 0 0 1 15 5.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 12.5v-9z"/></svg>
            <span class="file-name">movies/</span>
          </div>
          <div class="file-item">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M1 3.5A1.5 1.5 0 0 1 2.5 2h2.764c.958 0 1.76.56 2.311 1.184l.73.816H13.5A1.5 1.5 0 0 1 15 5.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 12.5v-9z"/></svg>
            <span class="file-name">photos/</span>
          </div>
          <div class="file-item">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2z"/></svg>
            <span class="file-name">notes.txt</span>
          </div>
          <p class="preview-foot">CONFINED TO BASE_DIR</p>
        </div>
      </div>

      <!-- 04: Metrics -->
      <div class="bento-card reveal">
        <div class="card-icon-bar">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <span class="card-num">04</span>
        </div>

        <h3 class="card-title">Live System Metrics</h3>
        <p class="card-desc">
          Monitor CPU, memory, disk, and network through the dashboard's live
          metrics stream.
        </p>

        <div class="card-micro-preview metrics-preview">
          <div class="preview-chrome">
            <span class="p-title">system</span>
            <span class="p-note">SCHEMATIC</span>
          </div>
          <div class="metric-row">
            <span class="metric-label">CPU</span>
            <span class="metric-track"><span class="metric-fill" style="width: 38%;"></span></span>
          </div>
          <div class="metric-row">
            <span class="metric-label">MEM</span>
            <span class="metric-track"><span class="metric-fill" style="width: 56%;"></span></span>
          </div>
          <div class="metric-row">
            <span class="metric-label">DISK</span>
            <span class="metric-track"><span class="metric-fill" style="width: 24%;"></span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container">
  <div class="hatch features-hatch" aria-hidden="true"></div>
</div>
</section>

<style>
  .features-section {
    position: relative;
    padding-block: 0;
  }

  .features-box {
    border-left: 1px solid var(--hc-border-subtle);
    border-right: 1px solid var(--hc-border-subtle);
    padding-block: clamp(64px, 8vw, 96px);
    padding-inline: clamp(24px, 4vw, 48px);
    box-sizing: border-box;
  }

  .features-hatch {
    height: 28px;
    background-color: var(--hc-canvas);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      var(--hc-border-default) 6px 7px
    );
    border: 1px solid var(--hc-border-subtle);
    box-sizing: border-box;
  }

  .features-header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-7);
  }

  .features-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .features-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .features-bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 1.6vw, 1.4rem);
  }

  .bento-card {
    position: relative;
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-border-default);
    border-radius: 3px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all var(--dur) var(--ease-out);
  }

  .bento-card:hover {
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.7);
  }

  .card-icon-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 3px;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-border-default);
    color: var(--hc-text-secondary);
  }

  .card-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--hc-text-muted);
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
    letter-spacing: -0.015em;
  }

  .card-desc {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .card-desc code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--text-primary);
  }

  /* Previews: consistent weight, one quiet well per card */
  .card-micro-preview {
    margin-top: auto;
    background: var(--hc-canvas);
    border: 1px solid var(--hc-border-subtle);
    border-radius: 3px;
    padding: 10px 12px;
    overflow: hidden;
  }

  .preview-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .p-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-tertiary);
  }

  .p-note {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .preview-foot {
    margin: 8px 0 0;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .preview-body {
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .c-prompt { color: var(--hc-text-tertiary); }
  .c-cmd { color: var(--hc-text-primary); }
  .c-dim { color: var(--text-tertiary); }
  .c-caret { color: var(--text-primary); }

  /* Docker rows: name + state only, no invented measurements */
  .docker-mini-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.02);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    margin-bottom: 4px;
  }

  .docker-mini-row:last-child {
    margin-bottom: 0;
  }

  .mini-status-led {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ok);
    flex-shrink: 0;
  }

  .docker-mini-row.is-stopped .mini-status-led {
    background: var(--text-muted);
  }

  .mini-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-primary);
    font-weight: 500;
  }

  .mini-state {
    font-size: 0.72rem;
    color: var(--ok-night);
    flex-shrink: 0;
  }

  .docker-mini-row.is-stopped .mini-state {
    color: var(--text-tertiary);
  }

  /* File rows */
  .file-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .file-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
  }

  /* Metrics: schematic bars, no numbers */
  .metric-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
  }

  .metric-row + .metric-row {
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .metric-label {
    width: 38px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-tertiary);
  }

  .metric-track {
    flex: 1;
    height: 5px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .metric-fill {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .features-bento-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .features-hatch {
      height: 22px;
    }
  }
</style>
