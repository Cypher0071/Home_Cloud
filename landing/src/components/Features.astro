---
// One continuous feature index: real capabilities, presented as a connected
// control surface instead of four separate product cards.
---

<section id="features" class="features-section" aria-labelledby="features-title">
  <div class="container">
    <div class="features-frame">
      <div class="features-intro reveal">
        <p class="features-kicker"><span aria-hidden="true"></span>THE CONTROL SURFACE</p>
        <h2 id="features-title" class="features-title">
          One host.<br />Four tools.
        </h2>
        <p class="features-desc">
          One dashboard for the work you already do on your server. Each tool
          reaches the same host, wherever you are.
        </p>
      </div>

      <ol class="feature-list" aria-label="Home Cloud tools">
        <li class="feature-row reveal" data-reveal-delay="1">
          <span class="feature-index" aria-hidden="true">01</span>
          <div class="feature-copy">
            <h3>Terminal</h3>
            <p>Open an interactive shell on the host. Sessions persist and can be replayed.</p>
          </div>
          <ul class="feature-capabilities" aria-label="Terminal capabilities">
            <li>INTERACTIVE PTY</li>
            <li>PERSISTENT SESSIONS</li>
            <li>REPLAY</li>
          </ul>
        </li>

        <li class="feature-row reveal" data-reveal-delay="2">
          <span class="feature-index" aria-hidden="true">02</span>
          <div class="feature-copy">
            <h3>Docker</h3>
            <p>Inspect containers, read logs, pull image updates, and deploy Compose projects.</p>
          </div>
          <ul class="feature-capabilities" aria-label="Docker capabilities">
            <li>CONTAINERS</li>
            <li>IMAGES</li>
            <li>COMPOSE</li>
          </ul>
        </li>

        <li class="feature-row reveal" data-reveal-delay="3">
          <span class="feature-index" aria-hidden="true">03</span>
          <div class="feature-copy">
            <h3>Files</h3>
            <p>Browse, search, upload, and download files within your configured host directory.</p>
          </div>
          <ul class="feature-capabilities" aria-label="File capabilities">
            <li>BROWSE</li>
            <li>SEARCH</li>
            <li><code>BASE_DIR</code></li>
          </ul>
        </li>

        <li class="feature-row reveal" data-reveal-delay="3">
          <span class="feature-index" aria-hidden="true">04</span>
          <div class="feature-copy">
            <h3>System metrics</h3>
            <p>Keep an eye on live CPU, memory, disk, and network activity.</p>
          </div>
          <ul class="feature-capabilities" aria-label="System metrics">
            <li>CPU</li>
            <li>MEMORY</li>
            <li>DISK</li>
            <li>NETWORK</li>
          </ul>
        </li>
      </ol>
    </div>

    <div class="hatch features-hatch" aria-hidden="true"></div>
  </div>
</section>

<style>
  .features-section {
    position: relative;
    padding-block: 0;
  }

  .features-frame {
    display: grid;
    grid-template-columns: minmax(250px, 0.78fr) minmax(0, 1.22fr);
    align-items: stretch;
    border-inline: 1px solid var(--hc-border-subtle);
  }

  .features-intro {
    align-self: start;
    padding: clamp(56px, 7vw, 88px) clamp(24px, 4vw, 48px);
  }

  .features-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--hc-space-5);
    color: var(--hc-text-tertiary);
    font-family: var(--hc-font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .features-kicker span {
    width: 6px;
    height: 6px;
    border: 1px solid var(--hc-accent);
  }

  .features-title {
    max-width: 10ch;
    margin-bottom: var(--hc-space-4);
    font-family: var(--hc-font-display);
    font-size: clamp(2.15rem, 2rem + 1.8vw, 3.15rem);
    font-weight: 550;
    line-height: 1.04;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .features-desc {
    max-width: 34ch;
    color: var(--hc-text-secondary);
    font-size: var(--hc-text-body);
    line-height: 1.6;
  }

  .feature-list {
    position: relative;
    display: grid;
    align-content: center;
    list-style: none;
    margin: 0;
    padding: clamp(36px, 5vw, 64px) clamp(24px, 4vw, 48px);
    border-left: 1px solid var(--hc-border-subtle);
  }

  .feature-list::before {
    position: absolute;
    top: clamp(36px, 5vw, 64px);
    bottom: clamp(36px, 5vw, 64px);
    left: 19px;
    width: 1px;
    background: var(--hc-border-default);
    content: '';
  }

  .feature-row {
    position: relative;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    column-gap: 18px;
    padding-block: 25px;
  }

  .feature-row:first-child {
    padding-top: 0;
  }

  .feature-row:last-child {
    padding-bottom: 0;
  }

  .feature-row + .feature-row {
    border-top: 1px solid var(--hc-border-subtle);
  }

  .feature-index {
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 4px;
    color: var(--hc-accent);
    font-family: var(--hc-font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .feature-index::before {
    position: absolute;
    top: 0.78em;
    left: -29px;
    width: 7px;
    height: 7px;
    border: 1px solid var(--hc-accent);
    background: var(--hc-canvas);
    content: '';
  }

  .feature-copy h3 {
    margin-bottom: 5px;
    color: var(--hc-text-primary);
    font-size: clamp(1.12rem, 1rem + 0.3vw, 1.28rem);
    font-weight: 550;
    letter-spacing: -0.025em;
  }

  .feature-copy p {
    max-width: 48ch;
    color: var(--hc-text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .feature-capabilities {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    color: var(--hc-text-tertiary);
    font-family: var(--hc-font-mono);
    font-size: 10px;
    letter-spacing: 0.045em;
  }

  .feature-capabilities li {
    position: relative;
  }

  .feature-capabilities li + li::before {
    position: absolute;
    top: 50%;
    left: -10px;
    width: 2px;
    height: 2px;
    background: var(--hc-accent);
    content: '';
    transform: translateY(-50%);
  }

  .feature-capabilities code {
    color: var(--hc-text-secondary);
    font-size: inherit;
  }

  .features-hatch {
    height: 28px;
    background-color: var(--hc-canvas);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      var(--hc-border-default) 6px 7px
    );
    border: 1px solid var(--hc-border-subtle);
  }

  @media (max-width: 800px) {
    .features-frame {
      grid-template-columns: minmax(0, 1fr);
    }

    .features-intro {
      padding-bottom: 36px;
    }

    .features-title {
      max-width: 14ch;
    }

    .feature-list {
      border-top: 1px solid var(--hc-border-subtle);
      border-left: 0;
      padding-block: 36px;
    }

    .feature-list::before {
      top: 36px;
      bottom: 36px;
      left: 0;
    }

    .feature-index::before {
      left: -29px;
    }
  }

  @media (max-width: 540px) {
    .features-intro {
      padding-inline: 22px;
    }

    .feature-list {
      padding-inline: 22px;
    }

    .feature-row {
      grid-template-columns: 30px minmax(0, 1fr);
      column-gap: 12px;
      padding-block: 22px;
    }

    .feature-index::before {
      left: -25px;
    }

    .feature-list::before {
      left: 0;
    }

    .feature-capabilities {
      gap: 7px 14px;
      font-size: 9px;
    }

    .features-hatch {
      height: 22px;
    }
  }
</style>
