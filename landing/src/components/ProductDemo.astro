          <div id="term-log">
            <div class="terminal-log-entry">
      <div class="terminal-log-cmd"><span class="term-prompt">demo@home-cloud:~$</span> <span>status</span></div>
      <div class="terminal-log-out">Host online · 4 containers running · Direct LAN connected</div>
    </div>
    <div class="terminal-log-entry">
      <div class="terminal-log-cmd"><span class="term-prompt">demo@home-cloud:~$</span> <span>uname -a</span></div>
      <div class="terminal-log-out">Linux home-cloud 6.8.0-45-generic x86_64 GNU/Linux</div>
    </div>
          </div>
          <form class="terminal-prompt-line" id="term-form">
            <span class="term-prompt">demo@home-cloud:~$</span>
            <input type="text" class="terminal-input" id="term-input" placeholder="Type a demo command..." autocomplete="off" spellcheck="false" />
          </form>
        </div>
      </div>
    `;

    // 3. Docker Manager
    let dockerTab = 'containers'; // 'containers' | 'images' | 'compose'
    let dockerFilter = 'all';
    let dockerSearch = '';

    const dockerImages = [
      { repo: 'ghcr.io/cypher0071/home-cloud', tag: 'latest', id: 'img-1a2b3c', size: '142 MB', created: '3 days ago' },
      { repo: 'ghcr.io/immich-app/immich-server', tag: 'release', id: 'img-4d5e6f', size: '890 MB', created: '5 days ago' },
      { repo: 'postgres', tag: '16-alpine', id: 'img-7g8h9i', size: '379 MB', created: '2 weeks ago' },
      { repo: 'cloudflare/cloudflared', tag: 'latest', id: 'img-0j1k2l', size: '64 MB', created: '1 week ago' },
      { repo: 'redis', tag: '7-alpine', id: 'img-3m4n5o', size: '32 MB', created: '3 weeks ago' }
    ];

    let dockerContainers = [
      { id: 'hc-01928374', name: 'home-cloud', tunnel: 'dashboard.home.tunnel', image: 'ghcr.io/cypher0071/home-cloud:latest', status: 'running', statusText: 'Up 3 days', ports: '3000:3000', age: '3d ago' },
      { id: 'im-92837461', name: 'immich-server', tunnel: 'photos.lan', image: 'ghcr.io/immich-app/immich-server:release', status: 'running', statusText: 'Up 2 days', ports: '2283:2283', age: '2d ago' },
      { id: 'pg-47291847', name: 'postgres', tunnel: '', image: 'postgres:16-alpine', status: 'running', statusText: 'Up 3 days', ports: '5432:5432', age: '3d ago' },
      { id: 'cf-83920194', name: 'cloudflared', tunnel: 'tunnel-gw', image: 'cloudflare/cloudflared:latest', status: 'running', statusText: 'Up 3 days', ports: 'tunnel', age: '3d ago' }
    ];

    const dockerMakeId = () => `ct-${Date.now().toString(36).slice(-4)}${Math.random().toString(36).slice(2, 5)}`;

    const dockerUniqueName = (base) => {
      const clean = String(base || 'container').toLowerCase().replace(/[^a-z0-9-]/g, '-');
      let name = clean;
      let counter = 2;
      while (dockerContainers.some(c => c.name === name)) {
        name = `${clean}-${counter++}`;
      }
      return name;
    };

    const dockerDeployPool = [
      { name: 'redis-cache', image: 'redis:7-alpine', ports: '6379:6379' },
      { name: 'nginx-proxy', image: 'nginx:alpine', ports: '8080:80' },
      { name: 'uptime-kuma', image: 'louislam/uptime-kuma:1', ports: '3001:3001' },
      { name: 'syncthing', image: 'syncthing/syncthing:latest', ports: '8384:8384' }
    ];

    const dockerAddContainer = ({ name, image, ports }) => {
      dockerContainers.push({
        id: dockerMakeId(),
        name: dockerUniqueName(name),
        tunnel: '',
        image,
        status: 'running',
        statusText: 'Up Just now',
        ports: ports || 'auto',
        age: 'Just now'
      });
    };

    const renderDocker = () => {
      const total = dockerContainers.length;
      const running = dockerContainers.filter(c => c.status === 'running').length;
      const stopped = total - running;
      const query = dockerSearch.trim().toLowerCase();
      const visible = dockerContainers.filter(c => {
        const matchesFilter = dockerFilter === 'all' || c.status === dockerFilter;
        const matchesQuery = !query || c.name.toLowerCase().includes(query) || c.image.toLowerCase().includes(query);
