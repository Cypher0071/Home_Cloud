</style>

<script>
  // ── Home Cloud Desktop Interactive Engine ──
  const desktop = document.querySelector('[data-demo-desktop]');
  if (desktop) {
    const workspace = desktop.querySelector('[data-workspace]');
    const clockEl = desktop.querySelector('[data-tray-clock]');
    const dockButtons = desktop.querySelectorAll('.taskbar-center .dock-item');
    const metricWidget = desktop.querySelector('.desktop-metric-widget');

    // Wallpapers
    let wallpapers = {};
    try {
      wallpapers = JSON.parse(desktop.getAttribute('data-wallpapers') || '{}');
    } catch (e) {}

    // Live Clock matching real product: "22:30 Thu, Oct 29"
    const updateClock = () => {
      const d = new Date();
      if (clockEl) {
        clockEl.textContent =
          d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false }) +
          '  ' +
          d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
      }
    };
    updateClock();
    setInterval(updateClock, 1000);

    // ── Multi-Window State System ──
    const windows = [
      { id: 'files', el: document.getElementById('win-files'), bodyEl: document.getElementById('body-files'), isOpen: true, isMin: false, isMax: false, x: 80, y: 35, w: 780, h: 440, zIndex: 11 },
      { id: 'terminal', el: document.getElementById('win-terminal'), bodyEl: document.getElementById('body-terminal'), isOpen: false, isMin: false, isMax: false, x: 130, y: 65, w: 680, h: 410, zIndex: 12 },
      { id: 'docker', el: document.getElementById('win-docker'), bodyEl: document.getElementById('body-docker'), isOpen: false, isMin: false, isMax: false, x: 110, y: 48, w: 820, h: 460, zIndex: 13 },
      { id: 'metrics', el: document.getElementById('win-metrics'), bodyEl: document.getElementById('body-metrics'), isOpen: false, isMin: false, isMax: false, x: 60, y: 40, w: 760, h: 520, zIndex: 14 },
      { id: 'settings', el: document.getElementById('win-settings'), bodyEl: document.getElementById('body-settings'), isOpen: false, isMin: false, isMax: false, x: 140, y: 40, w: 760, h: 540, zIndex: 15 }
    ];

    let activeWinId = 'files';
    let maxZIndex = 15;

    const updateDockDots = () => {
      windows.forEach(win => {
        const dot = document.getElementById(`dot-${win.id}`);
        if (dot) {
          dot.style.display = win.isOpen ? 'block' : 'none';
        }
      });
    };

    const updateActiveClasses = () => {
      windows.forEach(win => {
        if (!win.el) return;
        if (win.id === activeWinId && win.isOpen && !win.isMin) {
          win.el.classList.add('active');
        } else {
          win.el.classList.remove('active');
        }
      });

      dockButtons.forEach(btn => {
        const app = btn.getAttribute('data-dock');
        if (app === activeWinId) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      if (metricWidget) {
        if (activeWinId === 'metrics') {
          metricWidget.classList.add('active');
        } else {
          metricWidget.classList.remove('active');
        }
      }
    };

    const focusWindow = (id) => {
      const win = windows.find(w => w.id === id);
      if (!win || !win.el) return;
      maxZIndex++;
      win.zIndex = maxZIndex;
      win.el.style.zIndex = win.zIndex;
      activeWinId = id;
      updateActiveClasses();
    };

    const toggleMaximize = (win) => {
      if (!win || !win.el) return;
      const willMaximize = !win.el.classList.contains('maximized');
      win.isMax = willMaximize;
      const maxBtn = win.el.querySelector('[data-act="max"]');

      if (willMaximize) {
        win.el.dataset.preLeft = win.el.style.left;
        win.el.dataset.preTop = win.el.style.top;
        win.el.dataset.preWidth = win.el.style.width;
        win.el.dataset.preHeight = win.el.style.height;
        win.el.classList.add('maximized');
      } else {
        win.el.classList.remove('maximized');
        win.el.style.left = win.el.dataset.preLeft || `${win.x}px`;
        win.el.style.top = win.el.dataset.preTop || `${win.y}px`;
        win.el.style.width = win.el.dataset.preWidth || `${win.w}px`;
        win.el.style.height = win.el.dataset.preHeight || `${win.h}px`;
      }

      if (maxBtn) {
        maxBtn.title = willMaximize ? 'Restore' : 'Maximize';
        maxBtn.setAttribute('aria-label', willMaximize ? 'Restore' : 'Maximize');
        maxBtn.innerHTML = willMaximize
          ? `<svg width="10" height="10" viewBox="0 0 10 10" fill="none"><rect x="2.25" y="0.75" width="7" height="7" rx="0.75" stroke="currentColor" stroke-width="1.5"></rect><path d="M0.75 2.75V8.5a0.75 0.75 0 0 0 0.75 0.75H7.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>`
          : `<svg width="10" height="10" viewBox="0 0 10 10" fill="none"><rect x="0.75" y="0.75" width="8.5" height="8.5" rx="0.75" stroke="currentColor" stroke-width="1.5"></rect></svg>`;
      }
    };

    const handleDockClick = (id) => {
      const win = windows.find(w => w.id === id);
      if (!win || !win.el) return;

      if (!win.isOpen) {
        // Open window
        win.isOpen = true;
        win.isMin = false;
        win.el.style.display = 'flex';
        win.el.classList.remove('minimized');
        focusWindow(id);
        updateDockDots();
        return;
      }

      if (win.isMin) {
        // Restore from minimized
        win.isMin = false;
        win.el.style.display = 'flex';
        win.el.classList.remove('minimized');
        focusWindow(id);
        return;
      }

      if (activeWinId === id) {
        // Active window minimized on dock click
        win.isMin = true;
        win.el.classList.add('minimized');
        activeWinId = null;
        updateActiveClasses();
        return;
      }

      // Open but not active: focus it
      focusWindow(id);
    };

    // Attach Dock Click Listeners
    dockButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-dock');
        if (id) handleDockClick(id);
      });
    });

    if (metricWidget) {
      metricWidget.addEventListener('click', (e) => {
        e.stopPropagation();
        handleDockClick('metrics');
      });
    }

    // Initialize Window Behavior (Click to focus, drag, resize, min/max/close)
    windows.forEach(win => {
      if (!win.el) return;

      // Bring to top on mousedown anywhere inside window
      win.el.addEventListener('mousedown', () => {
        if (activeWinId !== win.id) {
          focusWindow(win.id);
        }
      });

      // Controls
      const minBtn = win.el.querySelector('[data-act="min"]');
      const maxBtn = win.el.querySelector('[data-act="max"]');
      const closeBtn = win.el.querySelector('[data-act="close"]');
      const titlebar = win.el.querySelector('[data-titlebar]');
      const resizeHandle = win.el.querySelector('[data-resize]');

      if (minBtn) {
        minBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          win.isMin = true;
          win.el.classList.add('minimized');
          if (activeWinId === win.id) {
            activeWinId = null;
            updateActiveClasses();
          }
        });
      }

      if (maxBtn) {
        maxBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleMaximize(win);
        });
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          win.isOpen = false;
          win.el.style.display = 'none';
          updateDockDots();
          if (activeWinId === win.id) {
            activeWinId = null;
            updateActiveClasses();
          }
        });
      }

      if (titlebar) {
        // Double click to toggle maximize
        titlebar.addEventListener('dblclick', (e) => {
          if (e.target.closest('.win-ctrl')) return;
          toggleMaximize(win);
        });

        // Draggable via Titlebar
        titlebar.addEventListener('mousedown', (e) => {
          if (win.el.classList.contains('maximized')) return;
          if (e.target.closest('.win-ctrl')) return;

          focusWindow(win.id);

          const startMouseX = e.clientX;
          const startMouseY = e.clientY;
          const startWinX = win.el.offsetLeft;
          const startWinY = win.el.offsetTop;

          desktop.classList.add('is-dragging');

          const onMouseMove = (moveEvent) => {
            const deltaX = moveEvent.clientX - startMouseX;
            const deltaY = moveEvent.clientY - startMouseY;

            const minX = -(win.el.offsetWidth - 80);
            const maxX = workspace.clientWidth - 80;
            const minY = 0;
            const maxY = workspace.clientHeight - 36;

            const nextX = Math.min(Math.max(minX, startWinX + deltaX), maxX);
            const nextY = Math.min(Math.max(minY, startWinY + deltaY), maxY);

            win.el.style.left = `${nextX}px`;
            win.el.style.top = `${nextY}px`;
            win.x = nextX;
            win.y = nextY;
          };

          const onMouseUp = () => {
            desktop.classList.remove('is-dragging');
            document.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseup', onMouseUp);
          };

          document.addEventListener('mousemove', onMouseMove);
          document.addEventListener('mouseup', onMouseUp);
        });
      }

      if (resizeHandle) {
        resizeHandle.addEventListener('mousedown', (e) => {
          e.stopPropagation();
          e.preventDefault();
          focusWindow(win.id);

          const startMouseX = e.clientX;
          const startMouseY = e.clientY;
          const startWidth = win.el.offsetWidth;
          const startHeight = win.el.offsetHeight;

          const onMouseMove = (moveEvent) => {
            const deltaX = moveEvent.clientX - startMouseX;
            const deltaY = moveEvent.clientY - startMouseY;

            const maxW = workspace.clientWidth - win.el.offsetLeft;
            const maxH = workspace.clientHeight - win.el.offsetTop;
            const newW = Math.max(480, Math.min(maxW, startWidth + deltaX));
            const newH = Math.max(280, Math.min(maxH, startHeight + deltaY));

            win.el.style.width = `${newW}px`;
            win.el.style.height = `${newH}px`;
            win.w = newW;
            win.h = newH;
          };

          const onMouseUp = () => {
            document.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseup', onMouseUp);
          };

          document.addEventListener('mousemove', onMouseMove);
          document.addEventListener('mouseup', onMouseUp);
        });
      }
    });

    // ── Global System & Demo State ──
    let allowSystemRoot = false;

    // ── App Content Renderers ──

    // 1. File Explorer
    const fileSystem = {
      '/': [
        { name: 'home', type: 'dir', size: '--', date: 'Today, 18:22' },
        { name: 'media', type: 'dir', size: '--', date: 'Oct 20, 10:15' },
        { name: 'docker', type: 'dir', size: '--', date: 'Oct 22, 14:00' },
        { name: 'etc', type: 'dir', size: '--', date: 'Oct 15, 08:30' },
        { name: 'var', type: 'dir', size: '--', date: 'Oct 15, 08:30' }
      ],
      '/home': [
