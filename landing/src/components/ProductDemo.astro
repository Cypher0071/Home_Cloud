      const rows = items.map(item => {
        const selected = item.name === fsSelected;
        return `
          <div class="file-item-row ${selected ? 'file-item-row-selected' : ''}" data-fs-item="${fsEscape(item.name)}" data-fs-type="${item.type}">
            <div class="file-name-cell">
              ${item.type === 'dir' ? fsFolderIcon : fsFileIcon(item.ext)}
              ${item.type === 'dir' ? `<b>${fsEscape(item.name)}</b>` : `<span>${fsEscape(item.name)}</span>`}
            </div>
            <span class="nowrap-cell" style="color: #737373; font-family: monospace;">${fsEscape(item.size || '--')}</span>
            <span class="nowrap-cell" style="color: #737373; font-family: monospace;">${fsEscape(item.date || '--')}</span>
          </div>
        `;
      }).join('');

      const emptyState = items.length === 0
        ? `<div class="fs-empty">${fsSearch.trim() ? `No items match “${fsEscape(fsSearch.trim())}”` : 'This folder is empty'}</div>`
        : '';

      return `
        <div class="files-container">
          <div class="address-bar-area">
            <div class="nav-button-group">
              <button type="button" class="nav-button ${canBack ? '' : 'disabled'}" data-fs-nav="back" aria-label="Back" title="Back" ${canBack ? '' : 'disabled'}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
              </button>
              <button type="button" class="nav-button ${canForward ? '' : 'disabled'}" data-fs-nav="forward" aria-label="Forward" title="Forward" ${canForward ? '' : 'disabled'}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </button>
              <button type="button" class="nav-button ${canUp ? '' : 'disabled'}" data-fs-nav="up" aria-label="Up one level" title="Up one level" ${canUp ? '' : 'disabled'}>
