    const fsCommit = () => {
      if (!bodyFiles) return;
      const active = document.activeElement;
      const wasSearchFocused = !!(active && active.classList && active.classList.contains('fs-search-input'));
      bodyFiles.innerHTML = renderFiles();
      attachFilesEvents();
      if (wasSearchFocused) {
        const input = bodyFiles.querySelector('.fs-search-input');
        if (input) {
          input.focus();
          const len = input.value.length;
          try { input.setSelectionRange(len, len); } catch (e) {}
        }
      }
      const createInput = bodyFiles.querySelector('.fs-create-input');
      if (createInput) {
        createInput.focus();
        createInput.select();
      }
    };

    const fsGoTo = (path, pushHistory = true) => {
      if (!path) return;
      if (!allowSystemRoot && path !== '/home' && !path.startsWith('/home/')) {
        path = '/home';
      }
      if (pushHistory) {
        fsHistory = fsHistory.slice(0, fsHistoryIdx + 1);
        if (fsHistory[fsHistory.length - 1] !== path) fsHistory.push(path);
        fsHistoryIdx = fsHistory.length - 1;
      }
      fsCurrentPath = path;
      fsSelected = null;
      fsSearch = '';
      fsCreating = null;
      fsCommit();
    };

    const fsCreateItem = () => {
      if (!fsCreating) return;
      const input = bodyFiles ? bodyFiles.querySelector('.fs-create-input') : null;
      const kind = fsCreating;
      const fallback = kind === 'folder' ? 'New Folder' : 'untitled.txt';
      const raw = ((input && input.value) || '').trim() || fallback;
      const items = fileSystem[fsCurrentPath] || (fileSystem[fsCurrentPath] = []);

      const splitName = (value) => {
        const dot = value.lastIndexOf('.');
        return dot > 0 ? [value.slice(0, dot), value.slice(dot)] : [value, ''];
      };

      let name = raw;
      let counter = 2;
      while (items.some(item => item.name === name)) {
        const [base, ext] = splitName(raw);
        name = `${base} (${counter++})${ext}`;
      }

      if (kind === 'folder') {
        items.push({ name, type: 'dir', size: '--', date: 'Today' });
        const childPath = fsJoinPath(fsCurrentPath, name);
        if (!fileSystem[childPath]) fileSystem[childPath] = [];
      } else {
        const ext = name.includes('.') ? name.split('.').pop().toLowerCase() : 'txt';
        items.push({ name, type: 'file', ext, size: '0 KB', date: 'Today' });
      }

      items.sort((a, b) => (a.type === b.type ? 0 : a.type === 'dir' ? -1 : 1));
      fsSelected = name;
      fsCreating = null;
      fsSearch = '';
      fsCommit();
    };

    // 2. Terminal
    let termHistory = [
      { cmd: 'status', out: 'Host online · 4 containers running · Direct LAN connected' },
      { cmd: 'uname -a', out: 'Linux home-cloud 6.8.0-45-generic x86_64 GNU/Linux' }
    ];

    const renderTerminal = () => `
      <div class="app-terminal">
        <div class="terminal-header-bar">
          <div class="terminal-tab-badge">
            <span class="terminal-dot"></span>
            <span>bash — demo@home-cloud:~</span>
