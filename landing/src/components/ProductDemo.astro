---
// landing/src/components/ProductDemo.astro
// 100% faithful 1:1 replica of the Home Cloud Desktop and OSWindow
// Derived directly from dashboard/src (desktop.tsx, OSWindow.tsx, files.tsx, DockerApp.tsx, SystemMonitorApp.tsx, TerminalApp.tsx, SettingsApp.tsx)
const { mode = 'interactive' } = Astro.props;
const preview = mode === 'preview';
import wpNight from '../../../dashboard/src/assets/wallpaper_night.jpg';
import wpWaves from '../../../dashboard/src/assets/desktop_wallpaper.jpg';
import wpMist from '../../../dashboard/src/assets/wallpaper_mist.jpg';
import wpSand from '../../../dashboard/src/assets/wallpaper_sand.jpg';
---

{preview ? (
  <div class="hc-desktop hc-desktop-preview" aria-label="Home Cloud desktop preview" style={`--wallpaper: url("${wpNight.src}")`}>
    <div class="hc-wallpaper"></div>
    <div class="hc-workspace">
      <div class="os-window active" style="left: 90px; top: 36px; width: 780px; height: 440px; z-index: 11;">
        <div class="window-titlebar">
          <div class="window-title-area">
            <span class="window-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path>
              </svg>
            </span>
            <span class="window-title">File Explorer</span>
          </div>
          <div class="window-controls">
            <span class="win-ctrl win-minimize" title="Minimize"><svg width="10" height="1" viewBox="0 0 10 1" fill="none"><line x1="0.75" y1="0.5" x2="9.25" y2="0.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line></svg></span>
            <span class="win-ctrl win-maximize" title="Maximize"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><rect x="0.75" y="0.75" width="8.5" height="8.5" rx="0.75" stroke="currentColor" stroke-width="1.5"></rect></svg></span>
            <span class="win-ctrl win-close" title="Close"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><line x1="1" y1="1" x2="9" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line><line x1="9" y1="1" x2="1" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line></svg></span>
          </div>
        </div>
        <div style="flex:1; background:#000000; padding:16px; color:#a1a1aa; font-size:12px;">File Explorer preview mode</div>
      </div>
    </div>
  </div>
) : (
  <section id="features" class="product-demo" aria-label="Interactive Home Cloud desktop demo">
    <div class="container demo-container">
      <div class="demo-frame">
        <div class="demo-device reveal">
        <div
          class="hc-desktop hc-desktop-live"
          data-demo-desktop
          data-wallpapers={JSON.stringify({
            night: wpNight.src,
            waves: wpWaves.src,
            mist: wpMist.src,
            sand: wpSand.src,
            charcoal: 'radial-gradient(ellipse at 50% 20%, #171717 0%, #000000 80%)'
          })}
          style={`--wallpaper: url("${wpNight.src}")`}
        >
          <div class="hc-wallpaper"></div>

          <!-- Desktop Workspace: inset 0 so windows and shadows flow behind dock without clipping -->
          <div class="hc-workspace" data-workspace>

            <!-- 1. FILE EXPLORER WINDOW -->
            <div class="os-window active" id="win-files" data-win="files" style="left: 80px; top: 35px; width: 780px; height: 440px; z-index: 11;">
              <div class="window-titlebar" data-titlebar="files">
                <div class="window-title-area">
                  <span class="window-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path>
                    </svg>
                  </span>
                  <span class="window-title">File Explorer</span>
                </div>
                <div class="window-controls">
                  <button type="button" class="win-ctrl win-minimize" data-act="min" aria-label="Minimize" title="Minimize">
                    <svg width="10" height="1" viewBox="0 0 10 1" fill="none"><line x1="0.75" y1="0.5" x2="9.25" y2="0.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line></svg>
                  </button>
                  <button type="button" class="win-ctrl win-maximize" data-act="max" aria-label="Maximize" title="Maximize">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><rect x="0.75" y="0.75" width="8.5" height="8.5" rx="0.75" stroke="currentColor" stroke-width="1.5"></rect></svg>
                  </button>
                  <button type="button" class="win-ctrl win-close" data-act="close" aria-label="Close" title="Close">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><line x1="1" y1="1" x2="9" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line><line x1="9" y1="1" x2="1" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line></svg>
                  </button>
                </div>
              </div>
              <div class="window-body" id="body-files">
      <div class="files-container">
        <div class="address-bar-area">
          <div class="nav-button-group">
            <span class="nav-button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg></span>
            <span class="nav-button disabled"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
            <span class="nav-button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></span>
          </div>
          <div class="breadcrumbs-box">
            <div class="breadcrumbs-scroll-area">
              <span>Home</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg>
              <span class="breadcrumb-segment-active">Documents</span>
            </div>
          </div>
          <div class="search-wrapper">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            <span>Search Documents</span>
          </div>
        </div>
        <div class="command-bar">
          <div class="command-group">
            <span class="primary-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg><span>Upload</span></span>
            <span class="command-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><span>New Folder</span></span>
            <span class="command-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><span>New File</span></span>
          </div>
        </div>
        <div class="files-workspace">
          <aside class="files-sidebar">
            <div class="sidebar-section-title">LOCATIONS</div>
            <div class="sidebar-item active">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24" stroke-width="2"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
              <span>Home</span>
            </div>
            <div class="sidebar-section-title" style="margin-top: 10px;">DEVICES</div>
            <div class="sidebar-item" style="opacity: 0.55; cursor: not-allowed;" title="System Root is hidden in Safe Server Mode. Enable in Settings -> Storage &amp; System.">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity: 0.5;"><line x1="22" x2="2" y1="12" y2="12"></line><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path></svg>
              <span style="color: #737373;">No external devices</span>
            </div>
            <div class="storage-indicator">
              <div class="storage-title"><span>Storage</span><span>24%</span></div>
              <div class="storage-bar"><div class="storage-progress" style="width: 24%;"></div></div>
              <div style="font-size: 9.5px; color: #737373; margin-top: 4px; font-family: monospace;">54.2 GB used of 225.8 GB</div>
            </div>
          </aside>
          <div class="files-content-area">
            <div class="file-list-header">
              <div>Name</div><div>Size</div><div>Date Modified</div>
            </div>
            <div class="file-items-container">
              <div class="file-item-row">
                <div class="file-name-cell"><svg width="15" height="15" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg><b>Backups</b></div>
                <span class="nowrap-cell" style="color: #737373; font-family: monospace;">--</span>
                <span class="nowrap-cell" style="color: #737373; font-family: monospace;">Today, 18:22</span>
              </div>
              <div class="file-item-row file-item-row-selected">
                <div class="file-name-cell"><svg width="15" height="15" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg><b>Documents</b></div>
                <span class="nowrap-cell" style="color: #737373; font-family: monospace;">--</span>
                <span class="nowrap-cell" style="color: #737373; font-family: monospace;">Yesterday</span>
              </div>
              <div class="file-item-row">
                <div class="file-name-cell"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M10 12.5 8 15l2 2.5"></path><path d="m14 12.5 2 2.5-2 2.5"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"></path></svg><span>docker-compose.yml</span></div>
                <span class="nowrap-cell" style="color: #737373; font-family: monospace;">3.2 KB</span>
                <span class="nowrap-cell" style="color: #737373; font-family: monospace;">Oct 26, 14:10</span>
              </div>
              <div class="file-item-row">
                <div class="file-name-cell"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a1a1a1" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></svg><span>home-cloud-notes.md</span></div>
                <span class="nowrap-cell" style="color: #737373; font-family: monospace;">1.8 KB</span>
                <span class="nowrap-cell" style="color: #737373; font-family: monospace;">Oct 24, 09:30</span>
              </div>
              <div class="file-item-row">
                <div class="file-name-cell"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a1a1a1" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></svg><span>server-inventory.csv</span></div>
                <span class="nowrap-cell" style="color: #737373; font-family: monospace;">840 B</span>
                <span class="nowrap-cell" style="color: #737373; font-family: monospace;">Oct 21, 19:45</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
              <div class="window-resize-handle" data-resize="files"></div>
            </div>

            <!-- 2. TERMINAL WINDOW -->
            <div class="os-window" id="win-terminal" data-win="terminal" style="left: 130px; top: 65px; width: 680px; height: 410px; z-index: 12; display: none;">
              <div class="window-titlebar" data-titlebar="terminal">
                <div class="window-title-area">
                  <span class="window-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="4 17 10 11 4 5"></polyline><line x1="12" x2="20" y1="19" y2="19"></line>
                    </svg>
                  </span>
                  <span class="window-title">Terminal</span>
                </div>
                <div class="window-controls">
                  <button type="button" class="win-ctrl win-minimize" data-act="min" aria-label="Minimize" title="Minimize">
                    <svg width="10" height="1" viewBox="0 0 10 1" fill="none"><line x1="0.75" y1="0.5" x2="9.25" y2="0.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line></svg>
                  </button>
                  <button type="button" class="win-ctrl win-maximize" data-act="max" aria-label="Maximize" title="Maximize">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><rect x="0.75" y="0.75" width="8.5" height="8.5" rx="0.75" stroke="currentColor" stroke-width="1.5"></rect></svg>
                  </button>
                  <button type="button" class="win-ctrl win-close" data-act="close" aria-label="Close" title="Close">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><line x1="1" y1="1" x2="9" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line><line x1="9" y1="1" x2="1" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line></svg>
                  </button>
                </div>
              </div>
              <div class="window-body" id="body-terminal">
      <div class="app-terminal">
        <div class="terminal-header-bar">
          <div class="terminal-tab-badge">
            <span class="terminal-dot"></span>
            <span>bash — demo@home-cloud:~</span>
          </div>
          <div class="terminal-actions">
            <button type="button" class="terminal-btn" id="btn-term-clear">Clear</button>
            <button type="button" class="terminal-btn" id="btn-term-help">Help</button>
          </div>
        </div>
        <div class="terminal-canvas" id="term-canvas">
          <div class="terminal-banner">Home Cloud Host Shell · Direct WebSockets on eth0</div>
          <div class="terminal-sub">Try commands: help, status, docker ps, uname -a, uptime, neofetch, clear.</div>
          <div id="term-log">
            <div class="terminal-log-entry">
      <div class="terminal-log-cmd"><span class="term-prompt">demo@home-cloud:~$</span> <span>status</span></div>
      <div class="terminal-log-out">Host online · 4 containers running · Direct LAN connected</div>
    </div>
    <div class="terminal-log-entry">
      <div class="terminal-log-cmd"><span class="term-prompt">demo@home-cloud:~$</span> <span>uname -a</span></div>
      <div class="terminal-log-out">Linux home-cloud 6.8.0-45-generic x86_64 GNU/Linux</div>
    </div>
          </div>
          <form class="terminal-prompt-line" id="term-form">
            <span class="term-prompt">demo@home-cloud:~$</span>
            <input type="text" class="terminal-input" id="term-input" placeholder="Type a demo command..." autocomplete="off" spellcheck="false" />
          </form>
        </div>
      </div>
    </div>
              <div class="window-resize-handle" data-resize="terminal"></div>
            </div>

            <!-- 3. DOCKER MANAGER WINDOW -->
            <div class="os-window" id="win-docker" data-win="docker" style="left: 110px; top: 48px; width: 820px; height: 460px; z-index: 13; display: none;">
              <div class="window-titlebar" data-titlebar="docker">
                <div class="window-title-area">
                  <span class="window-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path>
                    </svg>
                  </span>
                  <span class="window-title">Docker Manager</span>
                </div>
                <div class="window-controls">
                  <button type="button" class="win-ctrl win-minimize" data-act="min" aria-label="Minimize" title="Minimize">
                    <svg width="10" height="1" viewBox="0 0 10 1" fill="none"><line x1="0.75" y1="0.5" x2="9.25" y2="0.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line></svg>
                  </button>
                  <button type="button" class="win-ctrl win-maximize" data-act="max" aria-label="Maximize" title="Maximize">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><rect x="0.75" y="0.75" width="8.5" height="8.5" rx="0.75" stroke="currentColor" stroke-width="1.5"></rect></svg>
                  </button>
                  <button type="button" class="win-ctrl win-close" data-act="close" aria-label="Close" title="Close">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><line x1="1" y1="1" x2="9" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line><line x1="9" y1="1" x2="1" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line></svg>
                  </button>
                </div>
              </div>
              <div class="window-body" id="body-docker">
      <div class="app-docker">
        <div class="docker-header">
          <div class="docker-tabs">
            <button type="button" class="docker-tab-btn active" data-dtab="containers">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path></svg>
              <span>Containers</span>
              <span class="docker-badge">4</span>
            </button>
            <button type="button" class="docker-tab-btn " data-dtab="images">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle></svg>
              <span>Images</span>
              <span class="docker-badge">5</span>
            </button>
            <button type="button" class="docker-tab-btn " data-dtab="compose">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.9a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path></svg>
              <span>Compose</span>
              <span class="docker-badge">0</span>
            </button>
          </div>
          <button type="button" class="command-btn" id="docker-refresh-btn"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path><path d="M16 16h5v5"></path></svg><span>Refresh</span></button>
        </div>

        <div class="docker-content-wrapper">
          
            <div class="docker-filter-bar">
              <div class="docker-search-box">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                <input type="text" class="docker-search-input" placeholder="Search containers..." />
              </div>
              <div class="docker-pills">
                <button type="button" class="docker-pill active" data-dfilt="all">All (4)</button>
                <button type="button" class="docker-pill " data-dfilt="running">Running (4)</button>
                <button type="button" class="docker-pill " data-dfilt="stopped">Stopped (0)</button>
              </div>
              <div style="font-size: 11px; color: #737373; font-family: monospace;">4 running · 0 stopped</div>
              <button type="button" class="primary-btn">+ Deploy</button>
            </div>
            <div class="docker-table-container">
              <table class="docker-table">
                <thead>
                  <tr>
                    <th style="width: 28px;"></th>
                    <th>CONTAINER</th>
                    <th>IMAGE</th>
                    <th>STATUS</th>
                    <th>PORTS</th>
                    <th>AGE</th>
                    <th style="text-align: right;">ACTIONS</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><span class="docker-status-dot running"></span></td>
                    <td>
                      <div class="container-name-cell">
                        <b>home-cloud</b>
                        <span class="container-tunnel-badge"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" x2="22" y1="12" y2="12"></line></svg>dashboard.home.tunnel</span>
                      </div>
                      <div style="font-size: 10px; color: #737373; font-family: monospace;">hc-01928374</div>
                    </td>
                    <td><span class="image-tag-pill">ghcr.io/cypher0071/home-cloud:latest</span></td>
                    <td><span class="status-pill-green">Up 3 days</span></td>
                    <td><span style="font-family: monospace; font-size: 11px; color: #a1a1a1;">3000:3000</span></td>
