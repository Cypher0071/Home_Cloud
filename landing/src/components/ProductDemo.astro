        { id: 'security', label: 'Security & Sessions', icon: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>' },
        { id: 'updates', label: 'Updates & System', icon: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m16 12-4-4-4 4"/><path d="M12 16V8"/></svg>' }
      ];

      let bodyContent = '';

      if (settingsTab === 'personalization') {
        bodyContent = `
          <h1 class="settings-page-title">Background</h1>
          <p class="settings-page-hint">Personalize your desktop background across all your devices.</p>

          <div style="margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between;">
            <div style="font-size: 12.5px; font-weight: 500; color: #a1a1a1;">Choose a picture</div>
            <div style="display: inline-flex; align-items: center; gap: 3px; padding: 3px; background: #0a0a0a; border: 1px solid #262626; border-radius: 8px;">
              <span style="font-size: 11.5px; font-weight: 500; padding: 4px 10px; border-radius: 6px; background: #171717; color: #ffffff; border: 1px solid #333333;">Fill</span>
              <span style="font-size: 11.5px; font-weight: 500; padding: 4px 10px; border-radius: 6px; color: #737373;">Fit</span>
              <span style="font-size: 11.5px; font-weight: 500; padding: 4px 10px; border-radius: 6px; color: #737373;">Stretch</span>
              <span style="font-size: 11.5px; font-weight: 500; padding: 4px 10px; border-radius: 6px; color: #737373;">Center</span>
            </div>
          </div>

          <div class="wallpaper-grid">
            <div class="wallpaper-card ${currentWallpaper === 'night' ? 'active' : ''}" data-wp="night" style="background-image: url('${wallpapers.night || ''}');">
              <span class="wallpaper-name">Night Waves</span>
            </div>
            <div class="wallpaper-card ${currentWallpaper === 'waves' ? 'active' : ''}" data-wp="waves" style="background-image: url('${wallpapers.waves || ''}');">
              <span class="wallpaper-name">Desktop Waves</span>
            </div>
            <div class="wallpaper-card ${currentWallpaper === 'mist' ? 'active' : ''}" data-wp="mist" style="background-image: url('${wallpapers.mist || ''}');">
              <span class="wallpaper-name">Mist</span>
            </div>
            <div class="wallpaper-card ${currentWallpaper === 'sand' ? 'active' : ''}" data-wp="sand" style="background-image: url('${wallpapers.sand || ''}');">
              <span class="wallpaper-name">Desert Sand</span>
            </div>
          </div>
        `;
      } else if (settingsTab === 'storage') {
        bodyContent = `
          <h1 class="settings-page-title">Storage & System</h1>
          <p class="settings-page-hint">Manage filesystem boundaries, storage access scope, and system root visibility.</p>

          <div class="settings-card">
            <div class="settings-card-header">
              <h2 class="settings-card-title">Filesystem Scope & Permissions</h2>
              ${allowSystemRoot
                ? '<span class="settings-badge settings-badge-root"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg> Full Root Mode (/)</span>'
                : '<span class="settings-badge settings-badge-safe"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg> Safe Server Mode</span>'
              }
            </div>
            <p class="settings-card-desc">Configure whether Home Cloud is confined to user space and storage pools or has full visibility into the host operating system.</p>

            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-name">Allow Full System Root Access (/)</div>
                <p class="settings-row-hint">${allowSystemRoot
                  ? 'Enabled: The File Explorer and services can browse the entire server root (/etc, /var, etc.). Virtual kernel filesystems (/proc, /sys, /dev) remain blocked for process stability.'
                  : 'Disabled: Safe Server Mode is active. Access is confined to your user home ($HOME), mounted pools (/mnt, /media, /srv), and external drives.'
                }</p>
              </div>
              <button type="button" class="settings-switch ${allowSystemRoot ? 'active' : ''}" data-act="toggle-root" aria-label="Toggle root mode">
                <span class="settings-switch-thumb"></span>
              </button>
            </div>
          </div>

          <div class="settings-card">
            <h2 class="settings-card-title">Storage Mounts & User Home</h2>
            <p class="settings-card-desc">Active primary directories detected on this host.</p>
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-name">Default User Home (BASE_DIR)</div>
                <p class="settings-row-hint" style="font-family: var(--font-mono, monospace);">/home/admin/homecloud</p>
              </div>
            </div>
            <div class="settings-drive-grid">
              <div class="settings-drive-card">
                <div class="settings-drive-mount">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" x2="2" y1="12" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" x2="6.01" y1="16" y2="16"/><line x1="10" x2="10.01" y1="16" y2="16"/></svg>
                  /
                </div>
                <div class="settings-drive-details">/dev/nvme0n1p2 • ext4 • 476.8 GB (34% used)</div>
              </div>
              <div class="settings-drive-card">
                <div class="settings-drive-mount">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" x2="2" y1="12" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" x2="6.01" y1="16" y2="16"/><line x1="10" x2="10.01" y1="16" y2="16"/></svg>
                  /mnt/storage
                </div>
                <div class="settings-drive-details">/dev/sda1 • btrfs • 1.8 TB (12% used)</div>
              </div>
            </div>
          </div>
        `;
      } else if (settingsTab === 'security') {
        bodyContent = `
          <h1 class="settings-page-title">Security & Sessions</h1>
          <p class="settings-page-hint">Manage active authorization sessions, token revocation, and device access boundaries.</p>

          <div class="settings-card">
            <div class="settings-card-header">
              <h2 class="settings-card-title">Change Master Passcode</h2>
            </div>
            <p class="settings-card-desc">Update the administrative password used to sign into Home Cloud and access system services.</p>

            <form class="settings-form" id="form-password">
              <div class="settings-form-group">
                <label class="settings-form-label">Current Passcode</label>
                <input type="password" class="settings-input" placeholder="Enter current passcode" value="" autocomplete="current-password" />
              </div>
              <div class="settings-form-group">
                <label class="settings-form-label">New Passcode</label>
                <input type="password" class="settings-input" placeholder="At least 8 characters" />
              </div>
              <div class="settings-form-group">
                <label class="settings-form-label">Confirm New Passcode</label>
                <input type="password" class="settings-input" placeholder="Repeat new passcode" />
              </div>
              <button type="submit" class="settings-btn-primary" data-act="update-pass">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21 2-2 2m-1.5 1.5L14 9l-1.5-1.5-2 2 1.5 1.5L11 12l-1.5-1.5-2 2 1.5 1.5L8 15l-1.5-1.5-2 2 1.5 1.5-3 3a2.12 2.12 0 0 0 3 3l15-15-2-2z"/></svg>
                Update Passcode
              </button>
            </form>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h2 class="settings-card-title">Session Revocation & Token Epoch</h2>
              <span class="settings-badge settings-badge-safe"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg> Token Epoch Active</span>
            </div>
            <p class="settings-card-desc">Home Cloud issues cryptographically signed JWT tokens containing a server-side Token Epoch. Revoking sessions immediately invalidates active tokens across all browsers, phones, and devices.</p>

            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-name">Revoke All Active Sessions</div>
                <p class="settings-row-hint">Immediately invalidates all existing authorization cookies on every device.</p>
              </div>
              <button type="button" class="settings-btn-danger" data-act="revoke-sessions">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                Log Out Everywhere
              </button>
            </div>
          </div>
        `;
      } else if (settingsTab === 'updates') {
        bodyContent = `
          <h1 class="settings-page-title">Updates & System</h1>
          <p class="settings-page-hint">Manage Home Cloud core releases, review version changelogs, and perform zero-downtime upgrades.</p>

          <div class="settings-card">
            <div class="settings-card-header">
              <div style="display: flex; align-items: center; gap: 10px;">
                <h2 class="settings-card-title">Home Cloud Core</h2>
                <span class="settings-badge settings-badge-safe"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg> Up to Date</span>
              </div>
              <button type="button" class="settings-btn-secondary" data-act="check-update">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                ${checkingUpdates ? 'Checking…' : 'Check for Updates'}
              </button>
            </div>

            <div class="settings-version-box">
              <div>
                <div style="font-size: 11px; font-weight: 500; text-transform: uppercase; color: #737373;">Installed Version</div>
                <div style="font-size: 15px; font-weight: 600; font-family: var(--font-mono, monospace); color: #ffffff;">v1.4.2</div>
              </div>
              <div style="color: #404040;">/</div>
              <div>
                <div style="font-size: 11px; font-weight: 500; text-transform: uppercase; color: #737373;">Branch / Channel</div>
                <div style="font-size: 13px; font-weight: 500; color: #a1a1a1;">main (stable)</div>
              </div>
              <div style="margin-left: auto; text-align: right;">
                <div style="font-size: 11px; font-weight: 500; text-transform: uppercase; color: #737373;">Architecture</div>
                <div style="font-size: 12px; color: #ededed;">x86_64 Linux 6.8.0</div>
              </div>
            </div>

            <div style="font-size: 12.5px; font-weight: 600; color: #a1a1a1; margin-bottom: 6px;">Recent Changes</div>
            <div style="border: 1px solid #242424; border-radius: 6px; background: #0c0c0c; padding: 10px 14px; font-size: 11.5px; line-height: 1.5; color: #8a8a8a;">
              <div>• Added full-screen window maximize behavior behind taskbar dock</div>
              <div>• Real-time core telemetry with dynamic auto-fit grid layout</div>
              <div>• Instant container restart and zero-friction port exposure</div>
            </div>
          </div>
        `;
      }

      if (feedbackToast) {
        bodyContent += `
          <div class="settings-toast">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
            ${feedbackToast}
          </div>
        `;
      }

      return `
        <div class="app-settings">
          <aside class="settings-nav">
            ${navItems.map(item => `
              <button type="button" class="settings-nav-item ${settingsTab === item.id ? 'active' : ''}" data-settings-tab="${item.id}">
                ${item.icon}
                <span>${item.label}</span>
              </button>
            `).join('')}
          </aside>
          <div class="settings-body">
            ${bodyContent}
          </div>
        </div>
      `;
    };

    // Mount initial app contents
    const bodyFiles = document.getElementById('body-files');
    const bodyTerminal = document.getElementById('body-terminal');
    const bodyDocker = document.getElementById('body-docker');
    const bodyMetrics = document.getElementById('body-metrics');
    const bodySettings = document.getElementById('body-settings');

    if (bodyFiles) bodyFiles.innerHTML = renderFiles();
    if (bodyTerminal) bodyTerminal.innerHTML = renderTerminal();
    if (bodyDocker) bodyDocker.innerHTML = renderDocker();
    if (bodyMetrics) bodyMetrics.innerHTML = renderMetrics();
    if (bodySettings) bodySettings.innerHTML = renderSettings();

    // Attach App Events
    const attachFilesEvents = () => {
      if (!bodyFiles) return;

      // Back / Forward / Up navigation
      bodyFiles.querySelectorAll('[data-fs-nav]').forEach(btn => {
        if (btn.disabled) return;
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-fs-nav');
          if (action === 'back') {
            if (fsHistoryIdx <= 0) return;
            fsHistoryIdx -= 1;
            fsCurrentPath = fsHistory[fsHistoryIdx];
            fsSelected = null;
            fsSearch = '';
            fsCreating = null;
            fsCommit();
          } else if (action === 'forward') {
            if (fsHistoryIdx >= fsHistory.length - 1) return;
            fsHistoryIdx += 1;
            fsCurrentPath = fsHistory[fsHistoryIdx];
            fsSelected = null;
            fsSearch = '';
            fsCreating = null;
            fsCommit();
          } else if (action === 'up') {
            if (fsCurrentPath === '/') return;
            if (!allowSystemRoot && fsCurrentPath === '/home') return;
            fsGoTo(fsParentPath(fsCurrentPath));
          }
        });
      });

      // Breadcrumb segments
      bodyFiles.querySelectorAll('[data-fs-path]').forEach(btn => {
        btn.addEventListener('click', () => {
          const path = btn.getAttribute('data-fs-path');
          if (path) fsGoTo(path);
        });
      });

      // Sidebar locations
      bodyFiles.querySelectorAll('[data-fs-go]').forEach(item => {
        item.addEventListener('click', () => {
          const path = item.getAttribute('data-fs-go');
          if (path) fsGoTo(path);
        });
      });

      // File / folder rows
      const list = bodyFiles.querySelector('.file-items-container');
      if (list) {
        list.addEventListener('click', (e) => {
          const row = e.target.closest('[data-fs-item]');
          if (!row) return;
          const name = row.getAttribute('data-fs-item');
          const type = row.getAttribute('data-fs-type');
          if (!name) return;
          if (type === 'dir') {
            fsGoTo(fsJoinPath(fsCurrentPath, name));
            return;
          }
          fsSelected = name;
          list.querySelectorAll('.file-item-row-selected').forEach(el => el.classList.remove('file-item-row-selected'));
          row.classList.add('file-item-row-selected');
        });
      }

      // Live search filter
      const searchInput = bodyFiles.querySelector('.fs-search-input');
      if (searchInput) {
        searchInput.addEventListener('input', () => {
          fsSearch = searchInput.value;
          fsCommit();
        });
      }

      // New Folder / New File
      bodyFiles.querySelectorAll('[data-fs-new]').forEach(btn => {
        btn.addEventListener('click', () => {
          const kind = btn.getAttribute('data-fs-new');
          if (!kind) return;
          if (fsCreating === kind) {
            fsCreateItem();
            return;
          }
          fsCreating = kind;
          fsCommit();
        });
      });

      const createInput = bodyFiles.querySelector('.fs-create-input');
      if (createInput) {
        createInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            fsCreateItem();
          } else if (e.key === 'Escape') {
            e.preventDefault();
            fsCreating = null;
            fsCommit();
          }
        });
      }

      const submitCreate = bodyFiles.querySelector('[data-fs-create-submit]');
      if (submitCreate) submitCreate.addEventListener('click', fsCreateItem);

      const cancelCreate = bodyFiles.querySelector('[data-fs-create-cancel]');
      if (cancelCreate) {
        cancelCreate.addEventListener('click', () => {
          fsCreating = null;
          fsCommit();
        });
      }
    };

    const attachTerminalEvents = () => {
      const termForm = document.getElementById('term-form');
      const termInput = document.getElementById('term-input');
      const termLog = document.getElementById('term-log');
      const termCanvas = document.getElementById('term-canvas');
      const btnClear = document.getElementById('btn-term-clear');
      const btnHelp = document.getElementById('btn-term-help');

      const executeCmd = (cmd) => {
        const clean = cmd.trim();
        if (!clean) return;

        let output = '';
        if (clean === 'clear') {
          termHistory = [];
        } else if (clean === 'status') {
          output = 'Host online · 4 containers running · Direct LAN connected';
          termHistory.push({ cmd: clean, out: output });
        } else if (clean === 'uname -a') {
          output = 'Linux home-cloud 6.8.0-45-generic x86_64 GNU/Linux';
          termHistory.push({ cmd: clean, out: output });
        } else if (clean === 'docker ps') {
          output = 'CONTAINER ID   IMAGE                               COMMAND   STATUS         PORTS\nhc-01928374    ghcr.io/cypher0071/home-cloud       "node"    Up 3 days      3000/tcp\nim-92837461    ghcr.io/immich-app/immich-server    "start"   Up 2 days      2283/tcp\npg-47291847    postgres:16-alpine                  "pg"      Up 3 days      5432/tcp\ncf-83920194    cloudflare/cloudflared:latest       "tunnel"  Up 3 days';
          termHistory.push({ cmd: clean, out: output });
        } else if (clean === 'uptime') {
          output = '22:30:14 up 3 days, 14:18, 1 user, load average: 0.12, 0.08, 0.05';
          termHistory.push({ cmd: clean, out: output });
        } else if (clean === 'help') {
          output = 'Available demo commands: help, status, docker ps, uname -a, uptime, clear';
          termHistory.push({ cmd: clean, out: output });
        } else {
          output = `bash: ${clean}: command not found. Try 'help'.`;
          termHistory.push({ cmd: clean, out: output });
        }

        if (termLog) {
          termLog.innerHTML = termHistory.map(h => `
            <div class="terminal-log-entry">
              <div class="terminal-log-cmd"><span class="term-prompt">demo@home-cloud:~$</span> <span>${h.cmd}</span></div>
              <div class="terminal-log-out">${h.out}</div>
            </div>
          `).join('');
        }

        if (termCanvas) {
          termCanvas.scrollTop = termCanvas.scrollHeight;
        }
      };

      if (termForm && termInput) {
        termForm.addEventListener('submit', (e) => {
          e.preventDefault();
          executeCmd(termInput.value);
          termInput.value = '';
        });
      }

      if (btnClear) {
        btnClear.addEventListener('click', () => {
          termHistory = [];
          if (termLog) termLog.innerHTML = '';
        });
      }

      if (btnHelp) {
        btnHelp.addEventListener('click', () => {
          executeCmd('help');
        });
      }
    };

    const attachDockerEvents = () => {
      if (!bodyDocker) return;

      bodyDocker.querySelectorAll('[data-dtab]').forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-dtab');
          if (tab && tab !== dockerTab) {
            dockerTab = tab;
            dockerCommit();
          }
        });
      });

      bodyDocker.querySelectorAll('[data-dfilt]').forEach(pill => {
        pill.addEventListener('click', () => {
          const filt = pill.getAttribute('data-dfilt');
          if (filt && filt !== dockerFilter) {
            dockerFilter = filt;
            dockerCommit();
          }
        });
      });

      // Container search (name or image)
      const searchInput = bodyDocker.querySelector('.docker-filter-bar .docker-search-input');
      if (searchInput) {
        searchInput.addEventListener('input', () => {
          dockerSearch = searchInput.value;
          dockerCommit();
        });
      }

      // Start / Stop actions
      bodyDocker.querySelectorAll('[data-act="stop"], [data-act="start"]').forEach(btn => {
        btn.addEventListener('click', () => {
          const cid = btn.getAttribute('data-cid');
          const action = btn.getAttribute('data-act');
          const container = dockerContainers.find(c => c.id === cid);
          if (!container) return;

          if (action === 'stop' && container.status === 'running') {
            container.status = 'stopped';
            container.statusText = 'Exited (0) Just now';
            container.age = 'Just now';
            dockerCommit();
          } else if (action === 'start' && container.status === 'stopped') {
            container.status = 'running';
            container.statusText = 'Up Just now';
            container.age = 'Just now';
            dockerCommit();
          }
        });
      });

      // Deploy a new container
      const deployBtn = bodyDocker.querySelector('[data-docker-deploy]');
      if (deployBtn) {
        deployBtn.addEventListener('click', () => {
          const candidate = dockerDeployPool.find(item => !dockerContainers.some(c => c.name === item.name))
            || { name: `demo-service-${dockerContainers.length + 1}`, image: 'alpine:latest', ports: 'auto' };
          dockerAddContainer(candidate);
          dockerTab = 'containers';
          dockerFilter = 'all';
          dockerSearch = '';
          dockerCommit();
        });
      }

      const refreshBtn = bodyDocker.querySelector('[data-docker-refresh]');
      if (refreshBtn) refreshBtn.addEventListener('click', dockerCommit);

      // Run an image as a new container
      bodyDocker.querySelectorAll('[data-irun]').forEach(btn => {
        btn.addEventListener('click', () => {
          const image = btn.getAttribute('data-irun');
          if (!image) return;
          const repoName = image.split('/').pop().split(':')[0];
          dockerAddContainer({ name: repoName, image, ports: 'auto' });
          dockerTab = 'containers';
          dockerFilter = 'all';
          dockerSearch = '';
          dockerCommit();
        });
      });
    };

    const attachSettingsEvents = () => {
      if (!bodySettings) return;

      // Nav Tabs
      const navBtns = bodySettings.querySelectorAll('[data-settings-tab]');
      navBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-settings-tab');
          if (tab && tab !== settingsTab) {
            settingsTab = tab;
            feedbackToast = '';
            bodySettings.innerHTML = renderSettings();
            attachSettingsEvents();
          }
        });
      });

      // Wallpaper selection
      const wpCards = bodySettings.querySelectorAll('[data-wp]');
      wpCards.forEach(card => {
        card.addEventListener('click', () => {
          const wp = card.getAttribute('data-wp');
          if (wp && wallpapers[wp]) {
            currentWallpaper = wp;
            desktop.style.setProperty('--wallpaper', `url("${wallpapers[wp]}")`);
            bodySettings.innerHTML = renderSettings();
            attachSettingsEvents();
          }
        });
      });

      // Toggle root switch
      const toggleRootBtn = bodySettings.querySelector('[data-act="toggle-root"]');
      if (toggleRootBtn) {
        toggleRootBtn.addEventListener('click', () => {
          allowSystemRoot = !allowSystemRoot;
          if (!allowSystemRoot && fsCurrentPath !== '/home' && !fsCurrentPath.startsWith('/home/')) {
            fsCurrentPath = '/home';
            fsHistory = ['/home'];
            fsHistoryIdx = 0;
            fsSelected = null;
          }
          if (bodyFiles) {
            bodyFiles.innerHTML = renderFiles();
            attachFilesEvents();
          }
          feedbackToast = allowSystemRoot
            ? 'Full System Root Access (/) is now enabled across File Manager & services.'
            : 'Safe Server Mode is now active. Restricted to $HOME and storage mounts.';
          bodySettings.innerHTML = renderSettings();
          attachSettingsEvents();
          setTimeout(() => {
            if (feedbackToast) {
              feedbackToast = '';
              bodySettings.innerHTML = renderSettings();
              attachSettingsEvents();
            }
          }, 3500);
        });
      }

      // Password update form
      const passForm = bodySettings.querySelector('#form-password');
      if (passForm) {
        passForm.addEventListener('submit', (e) => {
          e.preventDefault();
          feedbackToast = 'Passcode updated successfully.';
          bodySettings.innerHTML = renderSettings();
          attachSettingsEvents();
          setTimeout(() => {
            feedbackToast = '';
            bodySettings.innerHTML = renderSettings();
            attachSettingsEvents();
          }, 3000);
        });
      }

      // Revoke sessions
      const revokeBtn = bodySettings.querySelector('[data-act="revoke-sessions"]');
      if (revokeBtn) {
        revokeBtn.addEventListener('click', () => {
          feedbackToast = 'All active sessions revoked. Cryptographic token epoch refreshed.';
          bodySettings.innerHTML = renderSettings();
          attachSettingsEvents();
          setTimeout(() => {
            feedbackToast = '';
            bodySettings.innerHTML = renderSettings();
            attachSettingsEvents();
          }, 3500);
        });
      }

      // Check update
      const checkUpdateBtn = bodySettings.querySelector('[data-act="check-update"]');
      if (checkUpdateBtn) {
        checkUpdateBtn.addEventListener('click', () => {
          checkingUpdates = true;
          bodySettings.innerHTML = renderSettings();
          attachSettingsEvents();
          setTimeout(() => {
            checkingUpdates = false;
            feedbackToast = 'Home Cloud Core is up to date (v1.4.2).';
            bodySettings.innerHTML = renderSettings();
            attachSettingsEvents();
            setTimeout(() => {
              feedbackToast = '';
              bodySettings.innerHTML = renderSettings();
              attachSettingsEvents();
            }, 3000);
          }, 700);
        });
      }
    };

    attachFilesEvents();
    attachTerminalEvents();
    attachDockerEvents();
    attachSettingsEvents();
    updateDockDots();
    updateActiveClasses();

    // Activity Monitor Live Telemetry simulation
    setInterval(() => {
      const cpuRand = 9.0 + (Math.random() * 4.0);
      const ramRand = 40.0 + (Math.random() * 3.0);
      cpuLoad = cpuRand;
      ramLoad = ramRand;

      const cpuVal = desktop.querySelector('[data-cpu-val]');
      const ramVal = desktop.querySelector('[data-ram-val]');
      if (cpuVal) cpuVal.textContent = `${Math.round(cpuRand)}%`;
      if (ramVal) ramVal.textContent = `${Math.round(ramRand)}%`;

      const cardCpuBadge = document.getElementById('metric-cpu-badge');
      const cardCpuVal = document.getElementById('metric-cpu-val');
      const cardCpuMeter = document.getElementById('metric-cpu-meter');
      if (cardCpuBadge) cardCpuBadge.textContent = `${cpuRand.toFixed(1)}%`;
      if (cardCpuVal) cardCpuVal.textContent = `${cpuRand.toFixed(1)}%`;
      if (cardCpuMeter) cardCpuMeter.style.width = `${cpuRand}%`;

      const cardRamBadge = document.getElementById('metric-ram-badge');
      const cardRamMeter = document.getElementById('metric-ram-meter');
      if (cardRamBadge) cardRamBadge.textContent = `${ramRand.toFixed(1)}%`;
      if (cardRamMeter) cardRamMeter.style.width = `${ramRand}%`;
    }, 2500);
  }
</script>
