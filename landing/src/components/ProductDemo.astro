      ],
      '/home/Backups': [
        { name: 'postgres-dump-2026.sql.gz', type: 'file', ext: 'sql', size: '142 MB', date: 'Yesterday, 23:00' },
        { name: 'immich-backup.tar', type: 'file', ext: 'tar', size: '1.1 GB', date: 'Oct 28, 04:00' },
        { name: 'config-backup.zip', type: 'file', ext: 'zip', size: '24 KB', date: 'Oct 25, 12:00' }
      ],
      '/home/Downloads': [
        { name: 'ubuntu-24.04-live-server.iso', type: 'file', ext: 'iso', size: '2.6 GB', date: 'Oct 25, 11:05' }
