      ],
      '/var': [
        { name: 'log', type: 'dir', size: '--', date: 'Today, 06:00' }
      ]
    };

    let fsCurrentPath = '/home';
    let fsHistory = ['/home'];
    let fsHistoryIdx = 0;
    let fsSelected = 'Documents';
    let fsSearch = '';
    let fsCreating = null; // 'folder' | 'file' | null

    const fsEscape = (value) => String(value == null ? '' : value).replace(/[&<>"']/g, (ch) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[ch]));

    const fsParentPath = (path) => (path === '/' ? '/' : path.slice(0, path.lastIndexOf('/')) || '/');
    const fsJoinPath = (base, name) => (base === '/' ? `/${name}` : `${base}/${name}`);

    const fsCrumbs = () => {
      if (fsCurrentPath === '/') return [{ label: '/', path: '/' }];

      if (fsCurrentPath === '/home' || fsCurrentPath.startsWith('/home/')) {
        const crumbs = [{ label: 'Home', path: '/home' }];
        let acc = '/home';
        fsCurrentPath.slice('/home'.length).split('/').filter(Boolean).forEach(part => {
          acc += `/${part}`;
          crumbs.push({ label: part, path: acc });
        });
        return crumbs;
      }

      const crumbs = [{ label: '/', path: '/' }];
      let acc = '';
      fsCurrentPath.split('/').filter(Boolean).forEach(part => {
        acc += `/${part}`;
        crumbs.push({ label: part, path: acc });
      });
      return crumbs;
    };

    const fsFolderIcon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>`;

    const fsFileIcon = (ext) => {
      const color = {
        yml: '#38bdf8', yaml: '#38bdf8', json: '#fbbf24', md: '#a1a1a1', txt: '#a1a1a1',
        csv: '#34d399', pdf: '#f87171', zip: '#c084fc', tar: '#c084fc', sql: '#60a5fa',
        iso: '#94a3b8', mkv: '#f472b6', drawio: '#fb923c'
      }[ext] || '#a1a1a1';

      return `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></svg>`;
    };

    const fsVisibleItems = () => {
      const items = fileSystem[fsCurrentPath] || [];
      const query = fsSearch.trim().toLowerCase();
      return query ? items.filter(item => item.name.toLowerCase().includes(query)) : items;
    };

    const renderFiles = () => {
      const crumbs = fsCrumbs();
      const currentLabel = crumbs[crumbs.length - 1].label;
      const items = fsVisibleItems();
      const canBack = fsHistoryIdx > 0;
      const canForward = fsHistoryIdx < fsHistory.length - 1;
      const canUp = fsCurrentPath !== '/' && (allowSystemRoot || fsCurrentPath !== '/home');
      const homeActive = fsCurrentPath === '/home' || fsCurrentPath.startsWith('/home/');
      const rootActive = fsCurrentPath === '/';

      const breadcrumbHtml = crumbs.map((crumb, index) => {
