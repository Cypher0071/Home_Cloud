          <td class="table-cell-age"><span style="font-family: monospace; color: #737373;">${fsEscape(c.age)}</span></td>
          <td style="text-align: right;">
            ${c.status === 'running'
              ? `<button type="button" class="docker-action-btn stop" data-act="stop" data-cid="${fsEscape(c.id)}" title="Stop ${fsEscape(c.name)}" aria-label="Stop ${fsEscape(c.name)}"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg></button>`
              : `<button type="button" class="docker-action-btn start" data-act="start" data-cid="${fsEscape(c.id)}" title="Start ${fsEscape(c.name)}" aria-label="Start ${fsEscape(c.name)}"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg></button>`}
          </td>
        </tr>
      `).join('');

