              </button>
            </div>
            <div class="breadcrumbs-box">
              <div class="breadcrumbs-scroll-area">${breadcrumbHtml}</div>
            </div>
            <div class="search-wrapper">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <input type="text" class="fs-search-input" value="${fsEscape(fsSearch)}" placeholder="Search ${currentLabel === '/' ? 'System Root' : fsEscape(currentLabel)}" aria-label="Search this folder" autocomplete="off" spellcheck="false" />
            </div>
          </div>
          <div class="command-bar">
            <div class="command-group">
              <span class="primary-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg><span>Upload</span></span>
              <button type="button" class="command-btn" data-fs-new="folder"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><span>New Folder</span></button>
              <button type="button" class="command-btn" data-fs-new="file"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><span>New File</span></button>
            </div>
          </div>
          <div class="files-workspace">
            <aside class="files-sidebar">
              <div class="sidebar-section-title">LOCATIONS</div>
              <div class="sidebar-item ${homeActive ? 'active' : ''}" data-fs-go="/home" role="button" tabindex="0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24" stroke-width="2"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
                <span>Home</span>
              </div>
              <div class="sidebar-section-title" style="margin-top: 10px;">DEVICES</div>
              ${allowSystemRoot ? `
                <div class="sidebar-item ${rootActive ? 'active' : ''}" data-fs-go="/" role="button" tabindex="0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" x2="2" y1="12" y2="12"></line><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path></svg>
                  <span>System Root (/)</span>
                </div>
              ` : `
                <div class="sidebar-item" style="opacity: 0.55; cursor: not-allowed;" title="System Root is hidden in Safe Server Mode. Enable in Settings -> Storage &amp; System.">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity: 0.5;"><line x1="22" x2="2" y1="12" y2="12"></line><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path></svg>
                  <span style="color: #737373;">No external devices</span>
                </div>
              `}
              <div class="storage-indicator">
                <div class="storage-title"><span>Storage</span><span>24%</span></div>
                <div class="storage-bar"><div class="storage-progress" style="width: 24%;"></div></div>
                <div style="font-size: 9.5px; color: #737373; margin-top: 4px; font-family: monospace;">54.2 GB used of 225.8 GB</div>
              </div>
            </aside>
            <div class="files-content-area">
              <div class="file-list-header">
                <div>Name</div><div>Size</div><div>Date Modified</div>
              </div>
              <div class="file-items-container">
                ${createRow}
                ${rows}
                ${emptyState}
              </div>
            </div>
          </div>
