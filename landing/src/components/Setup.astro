---
// landing/src/components/Setup.astro
// Compact 3-step setup: prepare -> run installer -> open dashboard.
// Copy states plainly that remote access needs separate Cloudflare setup;
// the installer terminal dramatization was removed for that reason.
---

<section id="setup" class="setup-section">
  <div class="container">
    <div class="setup-box">
      <div class="setup-header reveal">
      <p class="setup-eyebrow">GET STARTED</p>
      <h2 class="setup-title">
        From spare PC to private cloud.
      </h2>
      <p class="setup-desc">
        Install Home Cloud on a compatible Linux machine, then open the
        dashboard on your local network. Configure Cloudflare Tunnel separately
        if you want remote access.
      </p>
    </div>

    <div class="setup-steps-grid">
      <!-- Step 1 -->
      <div class="step-card reveal">
        <div class="step-badge">01</div>
        <h3 class="step-heading">Prepare your machine</h3>
        <p class="step-body">
          Use a compatible Linux machine with systemd and sudo access. Docker
          and the required dependencies are installed as part of setup where
          supported.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="step-card reveal">
        <div class="step-badge">02</div>
        <h3 class="step-heading">Run the installer</h3>
        <p class="step-body">
          Run the bootstrap command on your machine to install dependencies,
          build the dashboard, and configure the Home Cloud service.
        </p>
        <div class="step-cmd-box">
          <div class="step-cmd-header">
            <span class="step-cmd-label">Installer:</span>
            <button
              type="button"
              class="step-copy-btn"
              id="setup-step-copy"
              aria-label="Copy setup command"
              data-copy="curl -fsSL https://raw.githubusercontent.com/Cypher0071/Home_Cloud/main/setup.sh | bash"
            >
              <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="5" y="5" width="8" height="8" rx="1.5"></rect>
                <path d="M3 11V3a1.5 1.5 0 0 1 1.5-1.5H11"></path>
              </svg>
              <span id="setup-copy-text">Copy</span>
            </button>
          </div>
          <code class="step-cmd" id="setup-step-cmd">curl -fsSL https://raw.githubusercontent.com/Cypher0071/Home_Cloud/main/setup.sh | bash</code>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="step-card reveal">
        <div class="step-badge">03</div>
        <h3 class="step-heading">Open your dashboard</h3>
        <p class="step-body">
          Open the dashboard using your machine's LAN address. To access it
          remotely, complete Cloudflare Tunnel login and configure your domain
          and DNS.
        </p>
        <div class="access-rows">
          <div class="access-row">
            <span class="access-tag">LOCAL</span>
            <code class="access-addr">http://&lt;your-machine-ip&gt;:3000</code>
          </div>
          <div class="access-row is-remote">
            <span class="access-tag">REMOTE</span>
            <code class="access-addr">https://dash.&lt;your-domain&gt;</code>
            <span class="access-note">Requires Cloudflare setup</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

  <div class="container">
    <div class="hatch setup-hatch" aria-hidden="true"></div>
  </div>
</section>

<style>
  .setup-section {
    position: relative;
    padding-block: 0;
    background: var(--hc-canvas);
  }

  .setup-box {
    border-left: 1px solid var(--hc-border-subtle);
    border-right: 1px solid var(--hc-border-subtle);
    padding-block: clamp(64px, 8vw, 96px);
    padding-inline: clamp(24px, 4vw, 48px);
    box-sizing: border-box;
    width: 100%;
  }

  .setup-hatch {
    height: 28px;
    background-color: var(--hc-canvas);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      var(--hc-border-default) 6px 7px
    );
    border: 1px solid var(--hc-border-subtle);
    box-sizing: border-box;
  }

  .setup-header {
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: var(--space-6);
  }

  .setup-eyebrow {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
  }

  .setup-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .setup-desc {
    font-size: 1.02rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Compact 3-step row */
  .setup-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }

  .step-card {
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-border-default);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .step-badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .step-heading {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .step-body {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .step-cmd-box,
  .access-rows {
    margin-top: auto;
  }

  .step-cmd-box {
    background: var(--hc-canvas);
    border: 1px solid var(--hc-border-default);
    border-radius: 8px;
    padding: 10px 12px;
    min-width: 0;
  }

  .step-cmd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }

  .step-cmd-label {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  .step-cmd {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--hc-text-primary);
    line-height: 1.5;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .step-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-primary);
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
  }

  .step-copy-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  /* Access paths: local plain, remote flagged */
  .access-rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .access-row {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--hc-canvas);
    border: 1px solid var(--hc-border-default);
    border-radius: 8px;
    padding: 9px 12px;
    min-width: 0;
    flex-wrap: wrap;
  }

  .access-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  .access-row.is-remote .access-tag {
    color: var(--signal-text);
  }

  .access-addr {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--hc-text-primary);
    overflow-wrap: anywhere;
    word-break: break-word;
    flex: 1;
    min-width: 0;
  }

  .access-note {
    width: 100%;
    font-size: 0.72rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 900px) {
    .setup-steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Setup step copy button
  const stepCopyBtn = document.getElementById('setup-step-copy');
  const stepCopyText = document.getElementById('setup-copy-text');
  const stepCmd = document.getElementById('setup-step-cmd');

  if (stepCopyBtn && stepCmd) {
    stepCopyBtn.addEventListener('click', async () => {
      const textToCopy = stepCopyBtn.getAttribute('data-copy') || stepCmd.textContent || '';
      try {
        await navigator.clipboard.writeText(textToCopy);
        if (stepCopyText) stepCopyText.textContent = 'Copied!';
        setTimeout(() => {
          if (stepCopyText) stepCopyText.textContent = 'Copy';
        }, 2200);
      } catch (err) {
        // Fallback
        const textarea = document.createElement('textarea');
        textarea.value = textToCopy;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);

        if (stepCopyText) stepCopyText.textContent = 'Copied!';
        setTimeout(() => {
          if (stepCopyText) stepCopyText.textContent = 'Copy';
        }, 2200);
      }
    });
  }
</script>
