---
// landing/src/components/Setup.astro
// Install section in the ruled-band language: header, three step cells,
// then the pinned installer command. Version, Node.js minimum and links
// come from the latest GitHub release at build time (src/data/site.ts).
import { links, getRelease, installCommand, installerSource } from '../data/site';

const release = await getRelease();
const command = installCommand(release.tag);

const steps = [
  {
    num: '01',
    title: 'Prepare a Linux host',
    body: 'Any spare PC, mini PC or laptop running a systemd distribution such as Ubuntu or Debian. Install Node.js and Docker first; the installer checks for both.',
    facts: [
      ['OS', 'Linux with systemd'],
      ['CPU', 'x86_64 (ARM untested)'],
      ['Node.js', `${release.nodeMin} or newer`],
      ['Docker', 'Engine 24+'],
    ],
  },
  {
    num: '02',
    title: 'Run the installer',
    body: 'It handles the rest: pnpm, a SHA-256 verified cloudflared, the dashboard build, your password and a systemd service.',
    facts: [
      ['Release', release.tag],
      ['Service', 'home-cloud.service'],
    ],
  },
  {
    num: '03',
    title: 'Say yes to remote access',
    body: 'Sign in to Cloudflare in your browser and enter your domain. The installer creates the tunnel and the DNS record. No router settings, works behind CGNAT.',
    facts: [
      ['Local', 'http://<server-ip>:3000'],
      ['Remote', 'https://dash.<your-domain>'],
      ['Needs', 'Cloudflare account + domain'],
    ],
  },
];
---

<section id="setup" class="band setup" aria-labelledby="setup-title">
  <div class="container">
    <div class="band-frame">
      <header class="band-header reveal">
        <div>
          <p class="band-eyebrow">SETUP</p>
          <h2 id="setup-title" class="band-title">Running in three steps.</h2>
        </div>
        <p class="band-lede">
          One script installs the dashboard and, if you want it, puts it on your own domain over HTTPS. Remote access is a yes at one prompt, not a weekend of router settings.
        </p>
      </header>

      <ol class="setup-steps reveal" data-reveal-delay="1" aria-label="Installation steps">
        {steps.map((step) => (
          <li class="setup-step">
            <span class="step-num">{step.num}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-body">{step.body}</p>
            <dl class="step-facts">
              {step.facts.map(([key, value]) => (
                <div class="step-fact">
                  <dt>{key}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ol>

      <div class="setup-command band-pad reveal" data-reveal-delay="2">
        <div class="command-panel">
          <div class="command-toolbar">
            <span class="command-file">
              <span class="command-prompt" aria-hidden="true">$</span>
              setup.sh
              <span class="command-tag">{release.tag}</span>
            </span>
            <button type="button" class="command-copy" id="setup-copy" data-copy={command} aria-label="Copy installer commands">
              <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8" height="9" rx="1.5" /><path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H11" /></svg>
              <span id="setup-copy-label">Copy</span>
            </button>
          </div>
          <pre class="command-code"><code id="setup-command">{command.split('\n').map((line) => (<span class="command-line">{line}</span>))}</code></pre>
          <span id="setup-copy-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></span>
        </div>
      </div>

      <div class="band-foot">
        <p>The installer is a plain bash script, pinned to a release. Read it before you run it.</p>
        <span class="setup-foot-links">
          <a href={links.docsQuickstart} target="_blank" rel="noopener noreferrer">Full install guide <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          <a href={installerSource(release.tag)} target="_blank" rel="noopener noreferrer">Read installer source <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        </span>
      </div>
    </div>
    <div class="band-hatch" aria-hidden="true"></div>
  </div>
</section>

<style>
  .setup-foot-links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--hc-space-3) var(--hc-space-6);
  }







  /* Steps: three hairline cells, like the footer link table. */
  .setup-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hc-border-strong);
  }

  .setup-step {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--hc-space-6) clamp(24px, 4vw, 48px);
    border-right: 1px solid var(--hc-border-strong);
  }

  .setup-step:last-child {
    border-right: none;
  }

  .step-num {
    margin-bottom: var(--hc-space-5);
    font-family: var(--hc-font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--hc-accent);
  }

  .step-title {
    margin-bottom: var(--hc-space-2);
    font-family: var(--hc-font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--hc-text-primary);
  }

  .step-body {
    max-width: 42ch;
    margin-bottom: var(--hc-space-6);
    font-size: var(--hc-text-small);
    line-height: 1.6;
    color: var(--hc-text-secondary);
  }

  .step-facts {
    margin: auto 0 0;
    border-top: 1px solid var(--hc-border-default);
  }

  .step-fact {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--hc-space-3);
    align-items: baseline;
    padding-block: 10px;
    border-bottom: 1px solid var(--hc-border-default);
  }

  .setup-step {
    container-type: inline-size;
  }

  /* Narrow cells: stack label above value instead of breaking URLs mid-word. */
  @container (max-width: 330px) {
    .step-fact {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }

  .step-fact dt {
    font-family: var(--hc-font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--hc-text-tertiary);
  }

  .step-fact dd a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--hc-border-strong);
    text-underline-offset: 3px;
  }

  .step-fact dd a:hover {
    text-decoration-color: var(--hc-accent);
  }

  .step-fact dd {
    min-width: 0;
    margin: 0;
    font-family: var(--hc-font-mono);
    font-size: 13px;
    color: var(--hc-text-primary);
    overflow-wrap: anywhere;
  }

  /* Command: the focal action, full width under the steps. */
  .setup-command {
    padding-block: var(--hc-space-6);
    border-top: 1px solid var(--hc-border-strong);
  }

  .command-panel {
    border: 1px solid var(--hc-border-default);
    border-radius: var(--hc-radius-md);
    background: var(--hc-surface-1);
    overflow: hidden;
  }

  .command-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hc-space-4);
    padding: var(--hc-space-2) var(--hc-space-2) var(--hc-space-2) var(--hc-space-4);
    border-bottom: 1px solid var(--hc-border-default);
  }

  .command-file {
    display: inline-flex;
    align-items: center;
    gap: var(--hc-space-2);
    font-family: var(--hc-font-mono);
    font-size: 13px;
    color: var(--hc-text-primary);
  }

  .command-prompt {
    color: var(--hc-accent);
  }

  .command-tag {
    padding: 2px 6px;
    border: 1px solid var(--hc-border-default);
    border-radius: var(--hc-radius-sm);
    font-size: 12px;
    color: var(--hc-text-tertiary);
  }

  .command-copy {
    display: inline-flex;
    align-items: center;
    gap: var(--hc-space-2);
    min-height: 32px;
    padding-inline: var(--hc-space-3);
    border: 1px solid var(--hc-border-strong);
    border-radius: var(--hc-radius-sm);
    font-family: var(--hc-font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--hc-text-primary);
    transition:
      border-color var(--hc-duration-micro) var(--hc-ease-out),
      background-color var(--hc-duration-micro) var(--hc-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .command-copy:hover {
      border-color: var(--hc-text-tertiary);
      background: var(--hc-surface-2);
    }
  }

  .command-copy svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .command-code {
    margin: 0;
    padding: var(--hc-space-4) 0;
    overflow-x: auto;
    font-family: var(--hc-font-mono);
    font-size: 13px;
    line-height: 1.9;
    color: var(--hc-text-primary);
  }

  .command-code code {
    display: block;
    width: max-content;
    min-width: 100%;
    font: inherit;
    counter-reset: line;
  }

  .command-line {
    display: block;
    padding-inline: var(--hc-space-4);
    white-space: pre;
  }

  .command-line::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 1.5rem;
    margin-right: var(--hc-space-3);
    color: var(--hc-text-muted);
    user-select: none;
  }





  @media (max-width: 960px) {
    .setup-steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .setup-step {
      border-right: none;
      border-bottom: 1px solid var(--hc-border-strong);
    }

    .setup-step:last-child {
      border-bottom: none;
    }

    .step-body {
      max-width: 60ch;
    }
  }

  @media (max-width: 640px) {
    .setup-step {
      padding-inline: var(--hc-space-4);
    }

    .step-fact {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }

    .command-code {
      font-size: 12px;
    }
  }
</style>

<script>
  const copyButton = document.getElementById('setup-copy');
  const copyLabel = document.getElementById('setup-copy-label');
  const copyStatus = document.getElementById('setup-copy-status');

  copyButton?.addEventListener('click', async () => {
    const text = copyButton.getAttribute('data-copy') || '';
    let copied = false;

    try {
      await navigator.clipboard.writeText(text);
      copied = true;
    } catch {
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.appendChild(field);
      field.select();
      copied = document.execCommand('copy');
      field.remove();
    }

    if (copyLabel) copyLabel.textContent = copied ? 'Copied' : 'Copy failed';
    if (copyStatus) copyStatus.textContent = copied ? 'Installer commands copied to clipboard.' : 'Could not copy. Select the commands and copy them manually.';
    window.setTimeout(() => {
      if (copyLabel) copyLabel.textContent = 'Copy';
    }, 2000);
  });
</script>
