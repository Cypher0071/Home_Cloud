---
// landing/src/components/Footer.astro
// Double footer: diagonal hatch, bordered brand + link table, second hatch,
// then the copyright bar. Same destinations the page already exposes.
---

<footer class="ft-root">
  <div class="container">
    <div class="ft-hatch" aria-hidden="true"></div>

    <div class="ft-table">
      <div class="ft-brand">
        <div class="ft-brand-copy">
          <a href="#hero" class="ft-logo">
            <svg
              viewBox="0 0 32 32"
              width="22"
              height="22"
              fill="none"
              aria-hidden="true"
            >
              <defs>
                <mask id="footer-brand-mask">
                  <rect width="32" height="32" fill="#fff" />
                  <path
                    d="M9 21.5h14a4.5 4.5 0 0 0 .6-8.96A6.5 6.5 0 0 0 11.1 14 3.75 3.75 0 0 0 9 21.5Z"
                    fill="#000"
                    stroke="#000"
                    stroke-width="2"
                    stroke-linejoin="round"
                  />
                </mask>
              </defs>
              <circle cx="22.5" cy="9.5" r="3" fill="var(--hc-accent)" mask="url(#footer-brand-mask)" />
              <path
                d="M9 21.5h14a4.5 4.5 0 0 0 .6-8.96A6.5 6.5 0 0 0 11.1 14 3.75 3.75 0 0 0 9 21.5Z"
                fill="none"
                stroke="var(--hc-text-primary)"
                stroke-width="2"
                stroke-linejoin="round"
              />
            </svg>
            <span>Home Cloud</span>
          </a>
          <p class="ft-blurb">
            A private cloud that runs on your machine, under your control.
          </p>
        </div>

        <a
          class="ft-social"
          href="https://github.com/Cypher0071/Home_Cloud"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Home Cloud on GitHub (opens in a new tab)"
        >
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
        </a>
      </div>

      <nav class="ft-nav" aria-label="Footer">
        <div class="ft-col">
          <p class="ft-head">Product</p>
          <a class="ft-link" href="#hero">Overview</a>
          <a class="ft-link" href="#features">Features</a>
          <a class="ft-link" href="#setup">Setup</a>
        </div>
        <div class="ft-col">
          <p class="ft-head">How It Works</p>
          <a class="ft-link" href="#hiw-stage-1">Run it at home</a>
          <a class="ft-link" href="#hiw-stage-2">Connect outward</a>
          <a class="ft-link" href="#hiw-stage-3">Access it anywhere</a>
        </div>
        <div class="ft-col">
          <p class="ft-head">Project</p>
          <a class="ft-link" href="https://github.com/Cypher0071/Home_Cloud" target="_blank" rel="noopener noreferrer">
            Repository<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a class="ft-link" href="https://github.com/Cypher0071/Home_Cloud/issues" target="_blank" rel="noopener noreferrer">
            Issue Tracker<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a class="ft-link" href="https://github.com/Cypher0071/Home_Cloud/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">
            Apache-2.0<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </nav>
    </div>

    <div class="ft-hatch" aria-hidden="true"></div>

    <div class="ft-bar">
      <span class="ft-copy">© 2026 Home Cloud. Released under the Apache-2.0 License.</span>
      <span class="ft-note">Open source · Self-hosted · No cloud account required.</span>
    </div>
  </div>
</footer>

<style>
  .ft-root {
    background: var(--hc-canvas);
    color: var(--hc-text-secondary);
    padding-bottom: var(--hc-space-5);
  }

  /* Diagonal hatch. Same rule above the table and under it. */
  .ft-hatch {
    height: 28px;
    background-color: var(--hc-canvas);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      var(--hc-border-default) 6px 7px
    );
    border: 1px solid var(--hc-border-subtle);
    box-sizing: border-box;
  }

  .ft-table {
    display: grid;
    grid-template-columns: minmax(240px, 1.2fr) minmax(0, 3fr);
    border-left: 1px solid var(--hc-border-subtle);
    border-right: 1px solid var(--hc-border-subtle);
    box-sizing: border-box;
    background: var(--hc-canvas);
  }

  .ft-table + .ft-hatch {
    margin-top: -1px;
  }

  .ft-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--hc-space-5);
    min-width: 0;
    padding: 28px 28px 20px;
    border-right: 1px solid var(--hc-border-strong);
    border-bottom: 1px solid var(--hc-border-strong);
  }

  .ft-brand-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .ft-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--hc-text-primary);
    font-family: var(--hc-font-display);
    font-size: 1.0625rem;
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1;
    transition: color var(--hc-duration-micro) var(--hc-ease-out);
  }

  .ft-logo svg {
    display: block;
    flex-shrink: 0;
  }

  .ft-logo:hover {
    color: var(--hc-text-emphasis);
  }

  .ft-blurb {
    max-width: 32ch;
    font-size: var(--hc-text-small);
    line-height: 1.55;
    color: var(--hc-text-secondary);
  }

  .ft-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-top: auto;
    margin-left: -8px;
    color: var(--hc-text-tertiary);
    transition: color var(--hc-duration-micro) var(--hc-ease-out);
  }

  .ft-social:hover {
    color: var(--hc-text-primary);
  }

  .ft-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(4, minmax(64px, auto));
    min-width: 0;
  }

  .ft-col {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: 1 / -1;
    min-width: 0;
    border-right: 1px solid var(--hc-border-strong);
  }

  .ft-col:nth-child(1) { grid-column: 1; }
  .ft-col:nth-child(2) { grid-column: 2; }
  .ft-col:nth-child(3) {
    grid-column: 3;
    border-right: none;
  }

  .ft-head,
  .ft-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    margin: 0;
    padding: 16px 12px;
    border-bottom: 1px solid var(--hc-border-strong);
    font-family: var(--hc-font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-align: center;
  }

  .ft-head {
    color: var(--hc-text-primary);
  }

  .ft-link {
    color: var(--hc-text-secondary);
    transition:
      color var(--hc-duration-micro) var(--hc-ease-out),
      background-color var(--hc-duration-micro) var(--hc-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .ft-link:hover {
      color: var(--hc-text-emphasis);
      background: var(--hc-surface-1);
    }
  }

  .ft-link:active {
    background: var(--hc-surface-2);
  }

  .ft-logo:focus-visible,
  .ft-social:focus-visible,
  .ft-link:focus-visible {
    outline-offset: -3px;
    border-radius: 0;
  }

  .ft-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 28px;
    flex-wrap: wrap;
    padding: 18px 2px 4px;
    font-size: var(--hc-text-small);
    line-height: 1.45;
    color: var(--hc-text-muted);
  }

  .ft-note {
    margin-left: auto;
    text-align: right;
  }

  @media (max-width: 860px) {
    .ft-table {
      grid-template-columns: 1fr;
    }

    .ft-brand {
      padding: 24px 20px 16px;
      border-right: none;
    }

    .ft-nav {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .ft-col,
    .ft-col:nth-child(1),
    .ft-col:nth-child(2),
    .ft-col:nth-child(3) {
      display: flex;
      flex-direction: column;
      grid-column: auto;
      grid-row: auto;
      grid-template-rows: none;
      border-right: none;
    }
  }

  @media (max-width: 540px) {
    .ft-bar {
      flex-direction: column;
      align-items: flex-start;
    }

    .ft-note {
      margin-left: 0;
      text-align: left;
    }
  }
</style>
