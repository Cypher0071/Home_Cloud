---
// landing/src/components/Nav.astro
// Unified editorial engineering navigation header:
// Left: Brand icon + wordmark.
// Center: Features and Setup links.
// Right: GitHub link and Install action.
---

<header id="nav" class="nav-root">
  <div class="container nav-container">
    <div class="nav-bar">
      <!-- LEFT: Brand anchor -->
      <a href="#hero" class="nav-brand" aria-label="Home Cloud — Home">
        <svg
          viewBox="0 0 32 32"
          width="26"
          height="26"
          fill="none"
          class="brand-mark"
          aria-hidden="true"
        >
          <defs>
            <mask id="nav-brand-mask">
              <rect width="32" height="32" fill="#fff" />
              <path
                d="M9 21.5h14a4.5 4.5 0 0 0 .6-8.96A6.5 6.5 0 0 0 11.1 14 3.75 3.75 0 0 0 9 21.5Z"
                fill="#000"
                stroke="#000"
                stroke-width="2"
                stroke-linejoin="round"
              />
            </mask>
          </defs>
          <circle cx="22.5" cy="9.5" r="3" fill="var(--hc-accent, #ff4d17)" mask="url(#nav-brand-mask)" />
          <path
            d="M9 21.5h14a4.5 4.5 0 0 0 .6-8.96A6.5 6.5 0 0 0 11.1 14 3.75 3.75 0 0 0 9 21.5Z"
            fill="none"
            stroke="var(--hc-text-primary, #f9f5ef)"
            stroke-width="2"
            stroke-linejoin="round"
          />
        </svg>
        <span class="brand-name">Home Cloud</span>
      </a>

      <!-- MIDDLE: Navigation links -->
      <nav class="nav-links" aria-label="Main Navigation">
        <a href="#features" class="nav-link">Features</a>
        <a href="#setup" class="nav-link">Setup</a>
      </nav>

      <!-- RIGHT: Actions -->
      <div class="nav-actions">
        <a
          href="https://github.com/Cypher0071/Home_Cloud"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-gh-link"
          aria-label="View Home Cloud on GitHub"
        >
          <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
          <span class="gh-text">GitHub</span>
        </a>

        <a href="#setup" class="nav-install">
          <span>Install</span>
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4"></path>
          </svg>
        </a>

        <!-- Mobile toggle -->
        <button
          type="button"
          id="nav-toggle"
          class="nav-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="toggle-bar"></span>
          <span class="toggle-bar"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-nav" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-content">
      <nav class="mobile-nav-links">
        <a href="#features" class="mobile-link">Features</a>
        <a href="#setup" class="mobile-link">Setup</a>
      </nav>
      <div class="mobile-actions">
        <a
          href="https://github.com/Cypher0071/Home_Cloud"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-gh-btn"
        >
          View on GitHub
        </a>
        <a href="#setup" class="mobile-install-btn">
          Install Home Cloud
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-root {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: rgba(12, 12, 11, 0.78);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    transition: background-color 200ms var(--hc-ease-out);
  }

  .nav-root.is-scrolled {
    background: rgba(12, 12, 11, 0.92);
  }

  .nav-container {
    padding-inline: var(--hc-gutter);
  }

  .nav-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 56px;
    border: 1px solid var(--hc-border-subtle);
    padding-inline: clamp(16px, 2.5vw, 28px);
    transition: border-color 200ms var(--hc-ease-out);
  }

  .nav-root.is-scrolled .nav-bar {
    border-color: var(--hc-border-default);
  }

  /* LEFT: Brand */
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--hc-text-primary);
    width: fit-content;
  }

  .brand-mark {
    width: 26px;
    height: 26px;
    display: block;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--hc-font-sans);
    font-size: 0.9rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: var(--hc-text-primary);
    white-space: nowrap;
    transition: color 150ms var(--hc-ease-out);
  }

  .nav-brand:hover .brand-name {
    color: var(--hc-text-emphasis);
  }

  /* MIDDLE: Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    font-family: var(--hc-font-sans);
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--hc-text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms var(--hc-ease-out);
  }

  .nav-link:hover {
    color: var(--hc-text-primary);
  }

  /* RIGHT: Actions */
  .nav-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .nav-gh-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: 1px solid var(--hc-border-default);
    border-radius: 2px;
    color: var(--hc-text-secondary);
    font-family: var(--hc-font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms var(--hc-ease-out);
  }

  .nav-gh-link:hover {
    color: var(--hc-text-primary);
    border-color: var(--hc-border-strong);
  }

  .nav-install {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 2px;
    background: var(--hc-text-primary);
    color: #0c0c0b;
    font-family: var(--hc-font-sans);
    font-size: 0.82rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms var(--hc-ease-out),
      transform 100ms var(--hc-ease-out);
  }

  .nav-install:hover {
    background: var(--hc-text-emphasis);
  }

  .nav-install:active {
    transform: scale(0.98);
  }

  /* Focus states */
  .nav-brand:focus-visible,
  .nav-link:focus-visible,
  .nav-gh-link:focus-visible,
  .nav-install:focus-visible,
  .nav-toggle:focus-visible {
    outline: 2px solid var(--hc-accent);
    outline-offset: 3px;
  }

  /* Mobile toggle */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    border-radius: 2px;
    background: transparent;
    border: 1px solid var(--hc-border-default);
    color: var(--hc-text-primary);
    cursor: pointer;
    flex-shrink: 0;
  }

  .toggle-bar {
    width: 15px;
    height: 1.5px;
    background: currentColor;
    transition: transform 170ms var(--hc-ease-out);
  }

  .nav-toggle[aria-expanded='true'] .toggle-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .toggle-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile drawer */
  .mobile-drawer {
    display: none;
    background: rgba(12, 12, 11, 0.96);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    padding: 20px var(--hc-gutter) 24px;
  }

  .mobile-drawer.is-open {
    display: block;
  }

  .mobile-drawer-content {
    max-width: calc(var(--hc-container) + var(--hc-gutter) * 2);
    margin-inline: auto;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }

  .mobile-link {
    font-family: var(--hc-font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--hc-text-primary);
    padding: 10px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--hc-border-subtle);
  }

  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mobile-gh-btn,
  .mobile-install-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    border-radius: 2px;
    font-family: var(--hc-font-sans);
    font-weight: 550;
    font-size: 0.88rem;
    text-decoration: none;
  }

  .mobile-gh-btn {
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-border-default);
    color: var(--hc-text-primary);
  }

  .mobile-install-btn {
    background: var(--hc-text-primary);
    color: #0c0c0b;
  }

  @media (max-width: 860px) {
    .nav-bar {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }
    .nav-links,
    .nav-gh-link {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-name,
    .nav-link,
    .nav-gh-link,
    .nav-install,
    .toggle-bar {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById('nav');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 16);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  const toggle = document.getElementById('nav-toggle');
  const drawer = document.getElementById('mobile-nav');
  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      drawer.setAttribute('aria-hidden', String(isOpen));
      drawer.classList.toggle('is-open', !isOpen);
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        drawer.classList.remove('is-open');
      });
    });
  }
</script>
