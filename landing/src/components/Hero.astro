<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 56px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background: transparent;
  }

  /* Sparse dot field (atmosphere, not illustration) */
  .hero-dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1.6px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse 95% 85% at 38% 52%, black 25%, transparent 78%);
    mask-image: radial-gradient(ellipse 95% 85% at 38% 52%, black 25%, transparent 78%);
  }

  /* Hero stage container */
  .hero-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: stretch;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding-top: 0;
    padding-bottom: 0;
  }

  .hero-stage {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(32px, 4.5vw, 64px);
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border-left: 1px solid var(--hc-border-subtle);
    border-right: 1px solid var(--hc-border-subtle);
    padding-inline: clamp(24px, 4vw, 48px);
    padding-top: clamp(80px, 11vh, 112px);
    padding-bottom: clamp(40px, 5vh, 64px);
  }

  /* Text block — left-anchored, dominant */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 580px;
    width: 100%;
    min-width: 0;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--hc-space-5);
    font-family: var(--hc-font-mono);
    font-size: 12px;
    color: var(--hc-text-tertiary);
  }

  .kicker-mark {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border: 1px solid var(--hc-border-strong);
  }

  .hero-title {
    margin-bottom: var(--hc-space-5);
    font-family: var(--hc-font-display);
    font-size: var(--hc-text-display-xl);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.025em;
