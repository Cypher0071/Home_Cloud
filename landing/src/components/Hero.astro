      <!-- Left Column: Editorial engineering narrative -->
      <div class="hero-content">
        <p class="hero-kicker">
          <span class="kicker-mark" aria-hidden="true"></span>OPEN SOURCE · SELF-HOSTED
        </p>

        <h1 class="hero-title">
          YOUR COMPUTER.<br />YOUR CLOUD.
        </h1>

        <p class="hero-sub">
          Turn a spare PC, mini PC, or laptop into a private cloud you can reach from anywhere.
        </p>

        <div class="hero-cmd" id="hero-install-pill">
          <span class="cmd-prompt" aria-hidden="true">$</span>
          <code class="cmd-code" id="hero-install-cmd">curl -fsSL https://raw.githubusercontent.com/Cypher0071/Home_Cloud/main/setup.sh | bash</code>
          <button
            type="button"
            class="cmd-copy"
            id="hero-copy-btn"
            aria-label="Copy install command to clipboard"
            data-copy="curl -fsSL https://raw.githubusercontent.com/Cypher0071/Home_Cloud/main/setup.sh | bash"
          >
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="5" y="5" width="8" height="8" rx="1.5"></rect>
              <path d="M3 11V3a1.5 1.5 0 0 1 1.5-1.5H11"></path>
            </svg>
            <span id="hero-copy-label">Copy</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Hairline isometric illustration -->
      <div class="hero-visual">
        <svg class="hero-visual-svg" viewBox="-20 -155 676 547" role="img" aria-labelledby="hero-visual-title hero-visual-desc">
          <title id="hero-visual-title">Your PC, connected to your dashboard.</title>
