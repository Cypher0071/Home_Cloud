<script>
  // Tunnel signals: three dots travel tower → cloud → laptop on a slow loop.
  // Under reduced motion they park visibly along the path instead.
  const hvSvg = document.querySelector('.hero-visual-svg');
  const hPath = hvSvg?.querySelector('.tun') ?? null;
  const hDots = hvSvg ? Array.from(hvSvg.querySelectorAll('.hero-tunnel-signal')) : [];
  const hReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const HLOOP = 16000;
  let hLen = 0;

  if (hPath && typeof hPath.getTotalLength === 'function') {
    hLen = hPath.getTotalLength();
  }

  function hPlace(el, p) {
    const pt = hPath.getPointAtLength(hLen * p);
    el.setAttribute('cx', String(pt.x));
    el.setAttribute('cy', String(pt.y));
    const edge = Math.min(p, 1 - p) / 0.06;
    el.setAttribute('opacity', String(Math.min(1, edge)));
  }

  if (hLen > 0 && hDots.length > 0) {
    if (hReduced) {
      hDots.forEach((d, i) => {
        hPlace(d, (i + 0.5) / hDots.length);
        d.setAttribute('opacity', '0.9');
      });
    } else {
      const hStart = performance.now();
      const hTick = (now) => {
        const t = ((now - hStart) % HLOOP) / HLOOP;
        hDots.forEach((d, i) => hPlace(d, (t + i / hDots.length) % 1));
        requestAnimationFrame(hTick);
      };
      requestAnimationFrame(hTick);
    }
  }

  // Install command copy (preserved behavior + ids)
  const copyBtn = document.getElementById('hero-copy-btn');
  const copyLabel = document.getElementById('hero-copy-label');
  const installCmd = document.getElementById('hero-install-cmd');

  if (copyBtn && installCmd) {
    copyBtn.addEventListener('click', async () => {
      const textToCopy = copyBtn.getAttribute('data-copy') || installCmd.textContent || '';
      const markCopied = () => {
        copyBtn.classList.add('is-copied');
        if (copyLabel) copyLabel.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          if (copyLabel) copyLabel.textContent = 'Copy';
        }, 2200);
      };
      try {
        await navigator.clipboard.writeText(textToCopy);
        markCopied();
      } catch (err) {
        const textarea = document.createElement('textarea');
        textarea.value = textToCopy;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        markCopied();
      }
    });
  }
</script>
