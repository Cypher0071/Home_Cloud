---
// landing/src/components/Hero.astro
// Editorial engineering hero section:
// Left: Eyebrow, Display headline, Supporting copy, Terminal command box, CTAs, Meta specs.
// Right: Hairline isometric illustration (desktop PC, cloud gateway, laptop, live signal telemetry).
// Bottom: Structural diagonal-hatch separator transitioning into How It Works.
---

<section id="hero" class="hero">
  <!-- Sparse dot field (atmosphere, not illustration) -->
  <div class="hero-dots hero-dot-field" aria-hidden="true"></div>

  <!-- Hatch divider below the fixed nav -->
  <div class="container">
    <div class="hatch hatch-top" aria-hidden="true"></div>
  </div>

  <div class="container hero-container">
