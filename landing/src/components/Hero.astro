---
// landing/src/components/Hero.astro
// Editorial engineering hero section:
// Left: Eyebrow, Display headline, Supporting copy, two CTAs, release meta line.
// Right: Hairline isometric illustration (desktop PC, cloud gateway, laptop, live signal telemetry).
// Bottom: Structural diagonal-hatch separator transitioning into How It Works.
import { links, getRelease } from '../data/site';

const release = await getRelease();
---

<section id="hero" class="hero">
  <!-- Sparse dot field (atmosphere, not illustration) -->
  <div class="hero-dots hero-dot-field" aria-hidden="true"></div>

  <!-- Hatch divider below the fixed nav -->
  <div class="container">
    <div class="hatch hatch-top" aria-hidden="true"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-stage">
      <!-- Left Column: Editorial engineering narrative -->
      <div class="hero-content">
        <p class="hero-kicker">
          <span class="kicker-mark" aria-hidden="true"></span>OPEN SOURCE · SELF-HOSTED
        </p>

        <h1 class="hero-title">
          <span>YOUR</span><br />
          <span>COMPUTER.</span><br />
          <span class="hero-title-nowrap">YOUR CLOUD<span class="hero-title-period">.</span></span>
        </h1>

        <p class="hero-sub">
          Turn a spare PC, mini PC, or laptop into a private server. The installer sets up secure remote access for you, with no port forwarding or static IP.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary hero-btn" href="#setup">
            Get started
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </a>
          <a class="btn btn-ghost hero-btn" href={links.docs}>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 3h4A1.5 1.5 0 0 1 8 4.5V13a1 1 0 0 0-1-1H2.5V3ZM13.5 3h-4A1.5 1.5 0 0 0 8 4.5V13a1 1 0 0 1 1-1h4.5V3Z"></path></svg>
            Read the docs
          </a>
        </div>

        <p class="hero-meta">
          <a href={links.releases} target="_blank" rel="noopener noreferrer">{release.tag}<span class="sr-only"> release notes (opens in a new tab)</span></a>
          <span class="meta-dot" aria-hidden="true">·</span>
          <span>Apache-2.0</span>
          <span class="meta-dot" aria-hidden="true">·</span>
          <span>Free, no account needed</span>
        </p>
      </div>

      <!-- Right Column: Hairline isometric illustration -->
      <div class="hero-visual">
        <svg class="hero-visual-svg hero-intro" viewBox="-90 -155 746 547" role="img" aria-labelledby="hero-visual-title hero-visual-desc">
          <title id="hero-visual-title">Your PC, connected to your dashboard.</title>
          <desc id="hero-visual-desc">An ordinary desktop PC runs Home Cloud and connects to the Home Cloud remote access service, while a laptop opens the dashboard remotely.</desc>
          <g class="hero-host-rise">
            <g class="pc" transform="translate(-98, -172) translate(132, 296) scale(1.1) translate(-132, -296)">
              <path class="solid" d="M132,296 L200,262 L200,98 L96,46 L28,80 L28,244 Z"/>
              <path class="ln" d="M132,296 L132,132"/><path class="ln" d="M132,132 L200,98"/><path class="ln" d="M132,132 L28,80"/>
              <path class="dim" d="M142,126 L148,123"/><path class="dim" d="M152,121 L158,118"/>
              <path class="dim" d="M132,170 L200,136"/>
              <circle class="host-led-disk hero-boot-pulse" cx="152" cy="140" r="1.1"/><circle class="ln" r="4.2" transform="matrix(1 -0.5 0 -1 166 133)"/><circle class="host-led-live" cx="180" cy="126" r="1.5"/>
              <path class="dim" d="M132,198 L200,164"/><path class="dim" d="M144,182 L184,162"/><path class="dim" d="M144,190 L184,170"/>
              <path class="dim" d="M194,187 L200,184 L200,192 L194,195 Z"/><path class="ln" d="M194.96,187.8 L199.04,185.76 L199.04,191.52 L194.96,193.56 Z" fill="var(--hc-canvas)"/><circle class="sig hero-host-connection" cx="197" cy="189.5" r="0.9"/>
              <path class="dim" d="M148,248 L172,236"/><path class="dim" d="M148,238 L172,226"/><path class="dim" d="M148,228 L172,216"/>
            </g>
          </g>
          <g class="hero-tunnel">
            <path class="tun hero-tunnel-path" pathLength="1" d="M105.5,6.85 C145,20 175,68 205,68 L369,68 C415,68 444,196 430,294"/>
            <circle class="sig hero-tunnel-source" cx="105.5" cy="6.85" r="2.4" fill="var(--hc-canvas)" stroke="var(--hc-accent)" stroke-width="1.2"/><circle class="sig hero-tunnel-target" cx="430" cy="294" r="2.4" fill="var(--hc-canvas)" stroke="var(--hc-accent)" stroke-width="1.2"/>
            <circle class="sig hero-tunnel-signal" r="2.15" cx="104" cy="1" opacity="0"/><circle class="sig hero-tunnel-signal" r="2.15" cx="104" cy="1" opacity="0"/><circle class="sig hero-tunnel-signal" r="2.15" cx="104" cy="1" opacity="0"/>
            <g class="gateway-card hero-home-card" transform="translate(205.1, 37.3) scale(1.365)">
              <rect class="relay-card-bg" x="0" y="0" width="120" height="45" rx="6"/><circle class="relay-port" cx="0" cy="22.5" r="2"/><circle class="relay-port" cx="120" cy="22.5" r="2"/>
              <svg x="7.5" y="7" width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true"><defs><mask id="hero-home-cloud-mask"><rect width="32" height="32" fill="#fff"/><path d="M9 21.5h14a4.5 4.5 0 0 0 .6-8.96A6.5 6.5 0 0 0 11.1 14 3.75 3.75 0 0 0 9 21.5Z" fill="#000" stroke="#000" stroke-width="2" stroke-linejoin="round"/></mask></defs><circle cx="22.5" cy="9.5" r="3" fill="var(--hc-accent, #ff4d17)" mask="url(#hero-home-cloud-mask)"/><path d="M9 21.5h14a4.5 4.5 0 0 0 .6-8.96A6.5 6.5 0 0 0 11.1 14 3.75 3.75 0 0 0 9 21.5Z" fill="none" stroke="var(--hc-text-primary, #f9f5ef)" stroke-width="2" stroke-linejoin="round"/></svg>
              <text class="relay-title" x="39" y="20">HOME CLOUD</text><text class="relay-sub" x="39" y="32">REMOTE ACCESS</text><circle class="host-led-live" cx="108" cy="11.5" r="1.4"/>
            </g>
          </g>
        </svg>
        <div id="hero-laptop-figure" class="hero-laptop-figure hero-laptop-intro" aria-label="Interactive laptop. Move the pointer vertically to change how far it opens."></div>
      </div>
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    min-height: calc((100vh - 56px) * 1.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background: transparent;
  }

  /* Sparse dot field (atmosphere, not illustration) */
  .hero-dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1.6px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse 95% 85% at 38% 52%, black 25%, transparent 78%);
    mask-image: radial-gradient(ellipse 95% 85% at 38% 52%, black 25%, transparent 78%);
  }

  /* Hero stage container */
  .hero-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: stretch;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding-top: 0;
    padding-bottom: 0;
  }

  .hero-stage {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(32px, 4.5vw, 64px);
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border-left: 1px solid var(--hc-border-subtle);
    border-right: 1px solid var(--hc-border-subtle);
    padding-inline: clamp(24px, 4vw, 48px);
    padding-top: clamp(28px, 4.5vh, 48px);
    padding-bottom: clamp(24px, 3.5vh, 36px);
  }

  /* Text block — left-anchored, dominant */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 580px;
    width: 100%;
    min-width: 0;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-family: var(--hc-font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--hc-text-tertiary);
  }

  .kicker-mark {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border: 1px solid var(--hc-border-strong);
  }

  .hero-title {
    margin-bottom: 16px;
    font-family: var(--hc-font-display);
    font-size: clamp(3.15rem, 2.45rem + 2.4vw, 4.62rem);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.025em;
    color: var(--hc-text-primary);
  }

  .hero-title-nowrap {
    white-space: nowrap;
  }

  .hero-title-period {
    color: var(--hc-accent);
  }

  .hero-sub {
    max-width: 44ch;
    margin-bottom: 20px;
    font-size: clamp(0.92rem, 0.88rem + 0.2vw, 1.02rem);
    line-height: 1.55;
    color: var(--hc-text-secondary);
  }

  /* Actions: one primary, one secondary, same buttons as the closing band. */
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }

  .hero-btn svg {
    flex-shrink: 0;
  }

  .hero-actions .btn-ghost {
    border-color: var(--hc-border-strong);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--hc-font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--hc-text-tertiary);
  }

  .hero-meta a {
    color: var(--hc-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--hc-border-strong);
    text-underline-offset: 3px;
    transition: color var(--hc-duration-micro) var(--hc-ease-out), text-decoration-color var(--hc-duration-micro) var(--hc-ease-out);
  }

  .hero-meta a:hover {
    color: var(--hc-text-primary);
    text-decoration-color: var(--hc-accent);
  }

  .meta-dot {
    color: var(--hc-text-muted);
  }

  /* Illustration panel — unframed, art sits directly on the canvas */
  .hero-visual {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 620px;
    margin-left: auto;
    transform: scale(1.17);
    transform-origin: center;
    pointer-events: none;
    box-sizing: border-box;
  }

  .hero-visual-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    shape-rendering: geometricPrecision;
  }

  .hero-laptop-figure {
    position: absolute;
    z-index: 2;
    left: 46%;
    top: 47%;
    width: 62%;
    --hairline-plate: var(--hc-canvas);
    --hairline-hi: var(--hc-text-primary);
    --hairline-edge: var(--hc-text-primary);
    --hairline-mid: var(--hc-text-tertiary);
    --hairline-lo: var(--hc-border-subtle);
    --hairline-stroke: 1.25;
    pointer-events: auto;
  }

  .hero-laptop-figure.hero-laptop-intro {
    opacity: 0;
    transition: opacity 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-laptop-figure.hero-laptop-intro.is-visible {
    opacity: 1;
  }

  /* SVG styling */
  .solid {
    fill: var(--hc-canvas);
    stroke: var(--hc-text-primary);
    stroke-width: 1.35;
    stroke-linejoin: miter;
    stroke-miterlimit: 2.2;
  }

  .ln {
    fill: none;
    stroke: var(--hc-text-primary);
    stroke-width: 1.35;
    stroke-linejoin: miter;
    stroke-miterlimit: 2.2;
  }

  .dim {
    fill: none;
    stroke: var(--hc-text-tertiary);
    stroke-width: 1;
    stroke-linejoin: miter;
    stroke-miterlimit: 2.2;
  }

  .mark {
    fill: var(--hc-text-tertiary);
  }

  .tun {
    fill: none;
    stroke: var(--hc-accent);
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tun-feed {
    fill: none;
    stroke: var(--hc-accent);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0.65;
  }

  .sig {
    fill: var(--hc-accent);
  }

  .cloud {
    fill: var(--hc-canvas);
    stroke: var(--hc-text-primary);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  .relay-card-bg {
    fill: var(--hc-surface-1);
    stroke: var(--hc-border-default);
    stroke-width: 1.1;
  }

  .relay-port {
    fill: var(--hc-surface-1);
    stroke: var(--hc-accent);
    stroke-width: 1.2;
  }

  .relay-cloud {
    fill: var(--hc-surface-1);
    stroke: var(--hc-text-primary);
    stroke-width: 1.1;
    stroke-linejoin: round;
  }

  .relay-title {
    font-family: var(--hc-font-mono);
    font-size: 8px;
    font-weight: 600;
    fill: var(--hc-text-primary);
    letter-spacing: 0.7px;
  }

  .relay-sub {
    font-family: var(--hc-font-mono);
    font-size: 5.8px;
    fill: var(--hc-text-tertiary);
    letter-spacing: 0.5px;
  }

  .host-led-live {
    fill: var(--hc-success, #36c98f);
    filter: drop-shadow(0 0 2px rgba(54, 201, 143, 0.7));
    animation: host-heartbeat 3.6s ease-in-out infinite;
  }

  .host-led-disk {
    fill: var(--hc-accent, #ff6a3d);
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-intro .hero-host-rise {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
      transform-box: fill-box;
      transform-origin: center;
      transition:
        opacity 300ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hero-intro .hero-host-rise.is-forming {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .hero-intro .hero-host-rise:not(.is-formed) .host-led-live,
    .hero-intro .hero-host-rise:not(.is-formed) .hero-boot-pulse,
    .hero-intro .hero-host-rise:not(.is-formed) .sig {
      opacity: 0;
      animation: none;
    }

    .hero-intro .hero-host-rise.is-formed .hero-boot-pulse {
      transform-box: fill-box;
      transform-origin: center;
      animation: host-led-startup 850ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero-intro .hero-host-connection {
      opacity: 0;
      transition: opacity 150ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hero-intro .hero-host-connection.is-visible {
      opacity: 1;
    }

    .hero-intro .hero-tunnel-source {
      opacity: 0;
      transition: opacity 150ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hero-intro .hero-tunnel-source.is-visible {
      opacity: 1;
    }

    .hero-intro .hero-tunnel-path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    .hero-intro .hero-tunnel.is-connecting .hero-tunnel-path {
      animation: tunnel-connect 2250ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .hero-intro .hero-home-card {
      opacity: 0;
      transition: opacity 560ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hero-intro .hero-home-card.is-visible {
      opacity: 1;
    }

    .hero-intro .hero-tunnel-target {
      opacity: 0;
      transition: opacity 260ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hero-intro .hero-tunnel-target.is-visible {
      opacity: 1;
    }
  }

  @keyframes host-led-startup {
    0% { opacity: 0.08; transform: scale(0.55); }
    54% { opacity: 1; transform: scale(1.8); }
    100% { opacity: 0.8; transform: scale(1); }
  }

  @keyframes tunnel-connect {
    to { stroke-dashoffset: 0; }
  }

  @keyframes host-heartbeat {
    0%, 100% {
      opacity: 0.95;
      filter: drop-shadow(0 0 2.5px rgba(54, 201, 143, 0.8));
    }
    50% {
      opacity: 0.35;
      filter: drop-shadow(0 0 0.5px rgba(54, 201, 143, 0.2));
    }
  }

  /* Full-bleed diagonal-hatch divider bands */
  .hatch {
    height: var(--hc-hatch-height, 28px);
    flex-shrink: 0;
    background-color: var(--hc-canvas);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      var(--hc-border-default) 6px 7px
    );
  }

  .hatch-top {
    margin-top: 56px;
    border: 1px solid var(--hc-border-subtle);
  }

  @media (max-width: 1200px) {
    .hero-title {
      font-size: clamp(2.8rem, 2.25rem + 2vw, 4.02rem);
    }
  }

  @media (max-width: 960px) {
    .hero-stage {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding-top: clamp(36px, 5vh, 52px);
      padding-bottom: clamp(28px, 4vh, 40px);
    }
    .hero-content {
      max-width: 100%;
    }
    .hero-visual {
      max-width: 480px;
      width: 100%;
      min-width: 0;
      margin-inline: auto;
    }
  }

  @media (max-width: 640px) {
    .hero-stage {
      padding-top: clamp(28px, 4vh, 40px);
      padding-bottom: clamp(24px, 3.5vh, 32px);
    }
    .hero-title {
      font-size: clamp(2.48rem, 1.93rem + 2.6vw, 3.3rem);
      line-height: 1.05;
    }
    .hero-actions .btn {
      flex: 1 1 0;
      justify-content: center;
    }
    .hero-visual {
      max-width: 100%;
    }
    /* .hatch height controlled via --hc-hatch-height */
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-laptop-figure.hero-laptop-intro,
    .hero-laptop-figure.hero-laptop-intro.is-visible {
      opacity: 1;
      transition: none;
    }
    .hero-intro .hero-tunnel-path {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none;
    }
    .hero-intro .hero-home-card {
      opacity: 1;
      transition: none;
    }
    .hero-intro .hero-tunnel-target {
      opacity: 1;
      transition: none;
    }
    .host-led-live {
      animation: none;
      opacity: 0.9;
    }
  }
</style>

<script>
  import { laptop } from '@lucasmarkes/hairline';

  const hMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hReduced = hMotion.matches;
  const hvSvg = document.querySelector('.hero-visual-svg');
  const hPath = hvSvg?.querySelector('.hero-tunnel-path') ?? null;
  const heroTunnel = hvSvg?.querySelector('.hero-tunnel') ?? null;
  const hDots = hvSvg ? Array.from(hvSvg.querySelectorAll('.hero-tunnel-signal')) : [];
  const tunnelTarget = hvSvg?.querySelector('.hero-tunnel-target') ?? null;
  const HLOOP = 16000;
  const H_HOST_LINE_DURATION = 320;
  const H_HOST_LINE_STAGGER = 70;
  const H_CONNECT_DURATION = 2250;
  const H_CONNECTION_DOT_LEAD = 170;
  const hostMachine = hvSvg?.querySelector('.hero-host-rise') ?? null;
  const hostConnectionDot = hvSvg?.querySelector('.hero-host-connection') ?? null;
  const tunnelSource = hvSvg?.querySelector('.hero-tunnel-source') ?? null;
  let H_HOST_BUILD_DURATION = 0;
  if (!hReduced && hostMachine) {
    const hostLines = Array.from(hostMachine.querySelectorAll('path, circle.ln'))
      .map((path) => {
        const bounds = path.getBBox();
        return { path, midY: bounds.y + bounds.height / 2, length: path.getTotalLength() };
      })
      .sort((a, b) => b.midY - a.midY);

    hostLines.forEach(({ path, length }, index) => {
      path.style.setProperty('stroke-dasharray', String(length));
      path.style.setProperty('stroke-dashoffset', String(length));
      path.animate(
        [{ strokeDashoffset: length }, { strokeDashoffset: 0 }],
        {
          duration: H_HOST_LINE_DURATION,
          delay: index * H_HOST_LINE_STAGGER,
          easing: 'cubic-bezier(0.32, 0.72, 0, 1)',
          fill: 'forwards',
        },
      );
    });

    if (hostLines.length > 0) {
      H_HOST_BUILD_DURATION = (hostLines.length - 1) * H_HOST_LINE_STAGGER + H_HOST_LINE_DURATION;
      hostMachine.getBoundingClientRect();
      hostMachine.classList.add('is-forming');
      window.setTimeout(() => hostMachine.classList.add('is-formed'), H_HOST_BUILD_DURATION);
    }
  }

  const H_CONNECT_DELAY = H_HOST_BUILD_DURATION + 220;
  const H_CARD_REVEAL_DELAY = H_CONNECT_DELAY + Math.round(H_CONNECT_DURATION * 0.38);
  const H_LAPTOP_REVEAL_DELAY = H_CONNECT_DELAY + H_CONNECT_DURATION + 160;
  const H_LAPTOP_OPEN_DELAY = H_LAPTOP_REVEAL_DELAY + 650;
  const hIntroStarted = performance.now();
  let hLen = 0;

  if (hPath && typeof hPath.getTotalLength === 'function') {
    hLen = hPath.getTotalLength();
  }

  function hPlace(el, p) {
    const pt = hPath.getPointAtLength(hLen * p);
    el.setAttribute('cx', String(pt.x));
    el.setAttribute('cy', String(pt.y));
    const edge = Math.min(p, 1 - p) / 0.06;
    el.setAttribute('opacity', String(Math.min(1, edge)));
  }

  const laptopMount = document.getElementById('hero-laptop-figure');
  const homeCloudCard = hvSvg?.querySelector('.hero-home-card') ?? null;
  if (laptopMount) {
    laptop(laptopMount, {
      theme: 'dark',
      intensity: 0.38,
      play: false,
      label: 'Interactive laptop. Move the pointer vertically to change how far it opens.',
    });

    if (!hReduced) {
      let introDone = false;
      const introTimers = [];
      const clearIntro = () => {
        if (introDone) return;
        introDone = true;
        introTimers.forEach(clearTimeout);
        heroTunnel?.classList.add('is-connecting');
        hostConnectionDot?.classList.add('is-visible');
        tunnelSource?.classList.add('is-visible');
        homeCloudCard?.classList.add('is-visible');
        tunnelTarget?.classList.add('is-visible');
        laptopMount.classList.remove('hero-laptop-intro', 'is-visible');
        laptopMount.removeEventListener('pointermove', onUserInput, true);
        laptopMount.removeEventListener('pointerdown', onUserInput, true);
      };
      const onUserInput = (event) => {
        if (event.isTrusted) clearIntro();
      };
      const pointLaptop = (type, yRatio) => {
        const rect = laptopMount.getBoundingClientRect();
        laptopMount.dispatchEvent(new PointerEvent(type, {
          bubbles: type === 'pointermove',
          clientX: rect.left + rect.width / 2,
          clientY: rect.top + rect.height * yRatio,
          pointerId: 1,
          pointerType: 'mouse',
          isPrimary: true,
        }));
      };

      laptopMount.addEventListener('pointermove', onUserInput, true);
      laptopMount.addEventListener('pointerdown', onUserInput, true);
      pointLaptop('pointermove', 0.98);
      introTimers.push(setTimeout(() => {
        if (!introDone) {
          hostConnectionDot?.classList.add('is-visible');
          tunnelSource?.classList.add('is-visible');
        }
      }, Math.max(0, H_CONNECT_DELAY - H_CONNECTION_DOT_LEAD)));
      introTimers.push(setTimeout(() => {
        if (!introDone) heroTunnel?.classList.add('is-connecting');
      }, H_CONNECT_DELAY));
      introTimers.push(setTimeout(() => {
        if (!introDone) homeCloudCard?.classList.add('is-visible');
      }, H_CARD_REVEAL_DELAY));
      introTimers.push(setTimeout(() => {
        if (!introDone) tunnelTarget?.classList.add('is-visible');
      }, H_CONNECT_DELAY + H_CONNECT_DURATION));
      introTimers.push(setTimeout(() => {
        if (!introDone) laptopMount.classList.add('is-visible');
      }, H_LAPTOP_REVEAL_DELAY));
      introTimers.push(setTimeout(() => {
        if (!introDone) pointLaptop('pointermove', 0.03);
      }, H_LAPTOP_OPEN_DELAY));
      introTimers.push(setTimeout(() => {
        if (introDone) return;
        pointLaptop('pointerleave', 0.03);
        clearIntro();
      }, H_CONNECT_DELAY + H_CONNECT_DURATION + 1500));
    }
  }

  if (hLen > 0 && hDots.length > 0) {
    if (hReduced) {
      hDots.forEach((d, i) => {
        hPlace(d, (i + 0.5) / hDots.length);
        d.setAttribute('opacity', '0.9');
      });
    } else {
      const hStart = hIntroStarted + H_CONNECT_DELAY + H_CONNECT_DURATION + 150;
      const hTick = (now) => {
        if (now < hStart) {
          hDots.forEach((d) => d.setAttribute('opacity', '0'));
          requestAnimationFrame(hTick);
          return;
        }
        const t = ((now - hStart) % HLOOP) / HLOOP;
        hDots.forEach((d, i) => hPlace(d, (t + i / hDots.length) % 1));
        requestAnimationFrame(hTick);
      };
      requestAnimationFrame(hTick);
    }
  }

</script>
